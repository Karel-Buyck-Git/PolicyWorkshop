{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "management-esn-mapp",
  "properties": {
    "displayName": "Management Essential — Managed Application",
    "description": "**Essential** — Baseline hygiene for Managed Application: the non-negotiable controls every deployment should enforce from day one. This tier protects against credential theft, unencrypted data exposure, and accidental data loss for Managed Application workloads. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Managed Application",
      "domain": "Management",
      "tier": "Essential",
      "catalogueVersion": "2026.07.18",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "deployAssociationsManagedApplicationTargetManagedApplicationId": {
        "type": "String",
        "metadata": {
          "displayName": "Managed application ID",
          "description": "Resource ID of the managed application to which resources need to be associated."
        }
      },
      "deployAssociationsManagedApplicationResourceTypesToAssociate": {
        "type": "Array",
        "metadata": {
          "displayName": "Resource types to associate",
          "description": "The list of resource types to be associated to the managed application.",
          "strongType": "resourceTypes"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "17763ad9-70c0-4794-9397-53d765932634",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/17763ad9-70c0-4794-9397-53d765932634",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Deploy associations for a managed application"
        },
        "parameters": {
          "targetManagedApplicationId": {
            "value": "[parameters('deployAssociationsManagedApplicationTargetManagedApplicationId')]"
          },
          "resourceTypesToAssociate": {
            "value": "[parameters('deployAssociationsManagedApplicationResourceTypesToAssociate')]"
          },
          "associationNamePrefix": {
            "value": "DeployedByPolicy"
          }
        }
      }
    ]
  }
}
