{
  // ===========================================================================
  // Customer manifest (JSONC)  —  assembler input
  // EDIT RULE: change VALUES only. Do NOT add, remove or rename keys, and do
  // not introduce new objects/arrays. Structure is locked by
  // manifest.input.schema.json (additionalProperties:false everywhere).
  // Fill every <REPLACE: ...> before the build gate (manifest.schema.json).
  // ===========================================================================

  "schemaVersion": 1,

  // --- Customer identity (from the input form) ---
  "customer": "contoso",
  "prefix": "<REPLACE: prefix-slug>",            // defaults to customer if left blank
  "pacOwnerId": "<REPLACE: pacOwnerId-guid>",    // or leave for the assembler to generate

  // --- Provenance / lineage ---
  // Both pins come from catalogue/catalogue.json: catalogueVersion <- catalogueVersion,
  // catalogueContentHash <- contentHash. The version label is only a UTC date, so two
  // releases in one day share it; the contentHash is the exact pin and is what makes a
  // build reproducible. Delete the catalogueContentHash line to pin by label alone
  // (allowed, and the only key here you may remove) — but that is the weaker guarantee.
  "source": {
    "initiatives": "../../catalogue/initiatives",
    "catalogueVersion": "<REPLACE: catalogue-snapshot-id>",
    "catalogueContentHash": "<REPLACE: sha256:... from catalogue/catalogue.json>",
    "managementGroups": "../designs/contoso-mgmt-groups.json"   // resolves selection.managementGroup NAMES -> scope ids
  },

  // --- Output ---
  "output": {
    "root": "../package",                        // resolves to customer/package (relative to this manifest)
    "flavours": ["json"]                         // any of: json | terraform | bicep
  },

  // --- EPAC environments (pacSelector -> scope). enforcement: Audit | hardened ---
  "environments": [
    {
      "selector": "<REPLACE: pacSelector>",
      "tenantId": "<REPLACE: tenantId-guid>",
      "deploymentRootScope": "<REPLACE: /providers/Microsoft.Management/managementGroups/root-mg-id>",
      "managedIdentityLocation": "<REPLACE: location>",   // required: a selected initiative has DINE/Modify
      "enforcement": "<REPLACE: Audit-or-hardened>",
      "logAnalyticsWorkspaceId": "<REPLACE: log-analytics-workspace-resource-id>"
    }
  ],

  "allowedLocations": ["<REPLACE: location>"],

  // Excluded scopes, keyed by pacSelector
  "notScopes": {
    "<REPLACE: pacSelector>": ["<REPLACE: scope-resource-id>"]
  },

  // --- Selection (from the input form: domain/tier/category). Locked here. ---
  "selection": [
    { "domain": "integration", "category": "api-management", "tier": "essential",
      "managementGroup": "<REPLACE: target MG name from the design, e.g. mg-lv2-integration>" },
    { "domain": "management",  "category": "tags",           "tier": "essential" }
  ],

  // --- Parameter bindings: one key per required parameter of the selected
  //     initiatives (generated). Fill the VALUES only. ---
  "bindings": {
    "defaults": {
      "requireTagResourceGroupsTagName": "<REPLACE: requireTagResourceGroupsTagName>",
      "requireTagResourcesTagName": "<REPLACE: requireTagResourcesTagName>",
      "requireTagValueResourceGroupsTagName": "<REPLACE: requireTagValueResourceGroupsTagName>",
      "requireTagValueResourceGroupsTagValue": "<REPLACE: requireTagValueResourceGroupsTagValue>",
      "requireTagValueResourcesTagName": "<REPLACE: requireTagValueResourcesTagName>",
      "requireTagValueResourcesTagValue": "<REPLACE: requireTagValueResourcesTagValue>"
    },
    "overrides": {}
  },

  // Surgical per-policy effect overrides (optional; leave [] if unused)
  "effectOverrides": [],

  // Customer waivers per pacSelector (optional; leave {} if unused)
  "exemptions": {},

  // --- Governance metadata (fixed keys) ---
  "metadata": {
    "owner": "<REPLACE: owner-email>",
    "costCenterTag": "<REPLACE: cost-center-tag>",
    "contact": "<REPLACE: contact-name>"
  }
}
