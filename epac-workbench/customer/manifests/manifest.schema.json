{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contoso.dev/epac/manifest.schema.json",
  "title": "EPAC scaffold assembler \u2014 customer manifest",
  "description": "Input contract consumed by the Phase-4 assembler. Validated before any work is done (fail-fast).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "customer",
    "prefix",
    "source",
    "output",
    "environments",
    "selection"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest contract version. The assembler refuses versions it does not understand."
    },
    "customer": {
      "type": "string",
      "minLength": 1,
      "description": "Customer short name (used in folder/lineage)."
    },
    "prefix": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,22}[a-z0-9]$",
      "description": "Replaces the 'company' prefix in generated names. Lowercase slug, <=24 chars."
    },
    "pacOwnerId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Stable GUID identifying this EPAC instance. Optional: if omitted the assembler generates one and writes it back to the manifest."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initiatives"
      ],
      "properties": {
        "initiatives": {
          "type": "string",
          "description": "Path to the generated initiatives/ tree."
        },
        "catalogueVersion": {
          "type": "string",
          "description": "Catalogue version this manifest is pinned to (enforced at assemble time). Full provenance (contentHash, builtInsRef, hierarchyHash, engineVersion) is recorded in the package's lineage.json."
        },
        "catalogueContentHash": {
          "type": "string",
          "description": "Optional precise pin: the exact catalogue contentHash (sha256:...) this manifest was authored against. When set, the assembler fails if the catalogue's contentHash differs — guarding against a catalogue that changed under a stable version label."
        },
        "managementGroups": {
          "type": "string",
          "description": "Optional path (relative to the manifest) to the management-group hierarchy file (json/csv/xlsx/indent/edges) used to resolve selection.managementGroup names to scope ids."
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "flavours"
      ],
      "properties": {
        "root": {
          "type": "string",
          "description": "Base folder for the rendered scaffold."
        },
        "flavours": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "json",
              "terraform",
              "bicep"
            ]
          },
          "description": "Which renderers to run."
        }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "description": "EPAC environments (pacSelector -> scope) and per-environment posture.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "selector",
          "tenantId",
          "deploymentRootScope",
          "enforcement"
        ],
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "description": "pacSelector, e.g. epac-dev / tenant01."
          },
          "tenantId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "deploymentRootScope": {
            "type": "string",
            "pattern": "^/providers/Microsoft\\.Management/managementGroups/[^/]+$",
            "description": "Management group resource id (intermediate root)."
          },
          "managedIdentityLocation": {
            "type": "string",
            "description": "Default location for DINE/Modify managed identities."
          },
          "enforcement": {
            "enum": [
              "Audit",
              "hardened"
            ],
            "description": "Audit = observe only; hardened = enforce the baked effects (Deny/DINE/Modify)."
          },
          "logAnalyticsWorkspaceId": {
            "type": "string",
            "description": "Workspace resource id for diagnostics/DINE policies in this environment."
          },
          "strategy": {
            "enum": [
              "full",
              "ownedOnly"
            ],
            "description": "EPAC desiredState.strategy for this environment. 'ownedOnly' (default) manages only what this package deploys — safe for a brownfield tenant with pre-existing policy. 'full' lets EPAC delete any policy at/below the root scope it does not find in this package (greenfield only)."
          },
          "excludedScopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scopes EPAC's desiredState leaves untouched (resource ids). Only meaningful with strategy 'full'."
          }
        }
      }
    },
    "allowedLocations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Regions the customer permits."
    },
    "notScopes": {
      "type": "object",
      "description": "Scopes excluded, keyed by pacSelector.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "selection": {
      "type": "array",
      "minItems": 1,
      "description": "Which (domain, tier, category) initiative groups to deploy.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "category",
          "tier"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "description": "Domain slug from the hierarchy."
          },
          "category": {
            "type": "string",
            "description": "Category slug, or '*' for all categories in the domain."
          },
          "tier": {
            "enum": [
              "essential",
              "professional",
              "enterprise"
            ],
            "description": "Cumulative: professional pulls essential+professional; enterprise pulls all three."
          },
          "managementGroup": {
            "description": "Target management group name(s) from the hierarchy (source.managementGroups); resolved to scope ids. With no managementGroup and no scope, the selection gets a placeholder scope that Azure rejects.",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "scope": {
            "type": "object",
            "description": "Optional per-selection scope override, keyed by pacSelector (takes precedence over managementGroup).",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "enforcement": {
            "enum": [
              "Audit",
              "hardened"
            ],
            "description": "Optional per-selection posture override."
          },
          "notScopes": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "description": "Values for the <REPLACE: \u2026> mocks exposed by assignment files.",
      "properties": {
        "defaults": {
          "type": "object",
          "description": "Global parameter values, keyed by bubbled-up parameter name.",
          "additionalProperties": true
        },
        "overrides": {
          "type": "object",
          "description": "Per domain/category overrides, key = '<domain>/<category>'.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "effectOverrides": {
      "type": "array",
      "description": "Surgical per-policy effect overrides.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "policyDefinitionReferenceId",
          "effect"
        ],
        "properties": {
          "group": {
            "type": "string",
            "description": "<domain>/<tier>/<category>."
          },
          "policyDefinitionReferenceId": {
            "type": "string"
          },
          "effect": {
            "type": "string",
            "description": "Target effect, e.g. Audit/Deny/Disabled."
          }
        }
      }
    },
    "exemptions": {
      "type": "object",
      "description": "Customer waivers, keyed by pacSelector.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "category",
            "scopes"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "category": {
              "enum": [
                "Waiver",
                "Mitigated"
              ]
            },
            "expiresOn": {
              "type": "string",
              "format": "date",
              "description": "Required for Waiver."
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "group": {
              "type": "string",
              "description": "<domain>/<tier>/<category> to exempt (whole initiative)."
            },
            "policyDefinitionReferenceId": {
              "type": "string",
              "description": "Optional: exempt one member policy."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "category": {
                    "const": "Waiver"
                  }
                }
              },
              "then": {
                "required": [
                  "expiresOn"
                ]
              }
            }
          ]
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fixed governance keys. No additional properties permitted.",
      "properties": {
        "owner": {
          "type": "string"
        },
        "costCenterTag": {
          "type": "string"
        },
        "contact": {
          "type": "string"
        }
      }
    }
  }
}
