          "QueryStoreWaitStatisticsEnabled": {
            "value": "True"
          },
          "ErrorsEnabled": {
            "value": "True"
          },
          "DatabaseWaitStatisticsEnabled": {
            "value": "True"
          },
          "BlocksEnabled": {
            "value": "True"
          },
          "SQLInsightsEnabled": {
            "value": "True"
