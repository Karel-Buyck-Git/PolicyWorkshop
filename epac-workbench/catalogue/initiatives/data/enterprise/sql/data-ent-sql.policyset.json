          },
          "DeadlocksEnabled": {
            "value": "True"
          },
          "Basic": {
            "value": "True"
          },
          "InstanceAndAppAdvanced": {
            "value": "True"
          },
          "WorkloadManagement": {
            "value": "True"
          }
