{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "data-pro-hdi",
  "properties": {
    "displayName": "Data Professional — HDInsight",
    "description": "**Professional** — Active security posture for HDInsight: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "HDInsight",
      "domain": "Data",
      "tier": "Professional",
      "catalogueVersion": "2026.07.25",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureAzureHdinsightClustersPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for Azure HDInsight clusters",
          "description": "The private DNS zone name required for Azure HDInsight clusters to resolve a private DNS Zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureAzureHdinsightClustersPrivateDnsGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Group ID",
          "description": "Target group id (sub resource type) for the private endpoint."
        }
      },
      "configureAzureHdinsightClustersPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "configureAzureHdinsightClustersPrivateEndpointsGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Group ID",
          "description": "Target group id (sub resource type) for the private endpoint."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "b0ab5b05-1c98-40f7-bb9e-dc568e41b501",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/b0ab5b05-1c98-40f7-bb9e-dc568e41b501",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure HDInsight clusters should be injected into a virtual network"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "c8cc2f85-e019-4065-9fa3-5e6a2b2dde56",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/c8cc2f85-e019-4065-9fa3-5e6a2b2dde56",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure HDInsight should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "43d6e3bd-fc6a-4b44-8b4d-2151d8736a11",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/43d6e3bd-fc6a-4b44-8b4d-2151d8736a11",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure HDInsight clusters to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureHdinsightClustersPrivateDnsPrivateDnsZoneId')]"
          },
          "groupId": {
            "value": "[parameters('configureAzureHdinsightClustersPrivateDnsGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "2676090a-4baf-46ac-9085-4ac02cc50e3e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/2676090a-4baf-46ac-9085-4ac02cc50e3e",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure HDInsight clusters with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureAzureHdinsightClustersPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "groupId": {
            "value": "[parameters('configureAzureHdinsightClustersPrivateEndpointsGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
