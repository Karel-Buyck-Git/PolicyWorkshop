{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "data-pro-dbw",
  "properties": {
    "displayName": "Data Professional — Azure Databricks",
    "description": "**Professional** — Active security posture for Azure Databricks: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Azure Databricks",
      "domain": "Data",
      "tier": "Professional",
      "catalogueVersion": "2026.07.24",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureAzureDatabricksWorkspacePrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for workspaces",
          "description": "The private DNS zone name required for workspaces to resolve a private DNS Zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureAzureDatabricksWorkspacesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "Specifies the subnet to use to configure private endpoint",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "51c1490f-3319-459c-bbbc-7f391bbed753",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/51c1490f-3319-459c-bbbc-7f391bbed753",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Databricks Clusters should disable public IP"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "9c25c9e4-ee12-4882-afd2-11fb9d87893f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/9c25c9e4-ee12-4882-afd2-11fb9d87893f",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Databricks Workspaces should be in a virtual network"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0e7849de-b939-4c50-ab48-fc6b0f5eeba2",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0e7849de-b939-4c50-ab48-fc6b0f5eeba2",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Databricks Workspaces should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "258823f2-4595-4b52-b333-cc96192710d8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/258823f2-4595-4b52-b333-cc96192710d8",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Databricks Workspaces should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0eddd7f3-3d9b-4927-a07a-806e8ac9486c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0eddd7f3-3d9b-4927-a07a-806e8ac9486c",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Databricks workspace to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureDatabricksWorkspacePrivateDnsPrivateDnsZoneId')]"
          },
          "groupId": {
            "value": "databricks_ui_api"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "09210db3-d32c-4b2b-b4e1-f72ae920eb11",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/09210db3-d32c-4b2b-b4e1-f72ae920eb11",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Databricks Workspaces with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureAzureDatabricksWorkspacesPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
