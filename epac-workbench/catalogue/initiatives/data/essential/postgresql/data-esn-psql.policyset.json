{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "data-esn-psql",
  "properties": {
    "displayName": "Data Essential — PostgreSQL",
    "description": "**Essential** — Baseline hygiene for PostgreSQL: the non-negotiable controls every deployment should enforce from day one. This tier delivers TLS / HTTPS enforcement preventing in-transit interception and encryption-at-rest with service-managed keys. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "PostgreSQL",
      "domain": "Data",
      "tier": "Essential",
      "catalogueVersion": "2026.07.25",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "configurePostgresqlFlexibleServerConfigurationValueConfigurationName": {
        "type": "String",
        "metadata": {
          "displayName": "Configuration Name",
          "description": "The PostgreSQL configuration setting name"
        }
      },
      "configurePostgresqlFlexibleServerConfigurationValueConfigurationValue": {
        "type": "String",
        "metadata": {
          "displayName": "Configuration Value",
          "description": "The value to set for the configuration"
        }
      },
      "configurePostgresqlFlexibleServerEnableConfigurationConfigurationName": {
        "type": "String",
        "metadata": {
          "displayName": "Configuration Name",
          "description": "The PostgreSQL configuration setting name to enable"
        },
        "allowedValues": [
          "log_checkpoints",
          "log_connections",
          "log_disconnections",
          "connection_throttle.enable",
          "require_secure_transport"
        ]
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "ce39a96d-bf09-4b60-8c32-e85d52abea0f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ce39a96d-bf09-4b60-8c32-e85d52abea0f",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "A Microsoft Entra administrator should be provisioned for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "3bf854e8-b34a-47fe-9f81-bc558c82b3bd",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/3bf854e8-b34a-47fe-9f81-bc558c82b3bd",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure log_line_prefix with key identifiers for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "logLinePrefix": {
            "value": "%t-%c-user=%u,db=%d,app=%a,client=%h"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f5ed3f7a-cf5d-4ee6-9ede-b5d5192ccf81",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f5ed3f7a-cf5d-4ee6-9ede-b5d5192ccf81",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure logfiles.retention_days to at least 7 days for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "retentionDays": {
            "value": 7
          }
        }
      },
      {
        "policyDefinitionReferenceId": "eadbb524-8644-4a87-8af6-549e1d125982",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/eadbb524-8644-4a87-8af6-549e1d125982",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure pgaudit.log to include role, ddl, and misc for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "a7d3e5b1-8c4f-4a2b-9d6e-1f3c5a8b2e7d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/a7d3e5b1-8c4f-4a2b-9d6e-1f3c5a8b2e7d",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure PostgreSQL flexible server configuration to specified value"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "configurationName": {
            "value": "[parameters('configurePostgresqlFlexibleServerConfigurationValueConfigurationName')]"
          },
          "configurationValue": {
            "value": "[parameters('configurePostgresqlFlexibleServerConfigurationValueConfigurationValue')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "a8f89ff4-3d6e-4d7b-8c5a-2e9b1f4c8d3a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/a8f89ff4-3d6e-4d7b-8c5a-2e9b1f4c8d3a",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure PostgreSQL flexible server to enable specified configuration"
        },
        "parameters": {
          "configurationName": {
            "value": "[parameters('configurePostgresqlFlexibleServerEnableConfigurationConfigurationName')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "dd626066-39f5-4f72-aba8-06a99fabf278",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/dd626066-39f5-4f72-aba8-06a99fabf278",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure shared_preload_libraries to include pgaudit for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "1d14b021-1bae-4f93-b36b-69695e14984a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/1d14b021-1bae-4f93-b36b-69695e14984a",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Disconnections should be logged for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "c29c38cb-74a7-4505-9a06-e588ab86620a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/c29c38cb-74a7-4505-9a06-e588ab86620a",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Enforce SSL connection should be enabled for PostgreSQL flexible servers"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "a43d5475-c569-45ce-a268-28fa79f4e87a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/a43d5475-c569-45ce-a268-28fa79f4e87a",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "PostgreSQL flexible servers should be running TLS version 1.2 or newer"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      }
    ]
  }
}
