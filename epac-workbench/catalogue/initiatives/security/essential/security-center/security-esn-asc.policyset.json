{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "security-esn-asc",
  "properties": {
    "displayName": "Security Essential — Security Center",
    "description": "**Essential** — Baseline hygiene for Defender for Cloud: the non-negotiable controls every deployment should enforce from day one. This tier delivers RBAC and managed-identity controls eliminating shared credentials and TLS / HTTPS enforcement preventing in-transit interception. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Security Center",
      "domain": "Security",
      "tier": "Essential",
      "catalogueVersion": "2026.07.28",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c",
        "/providers/Microsoft.Authorization/roleDefinitions/cd570a14-e51a-42ad-bac8-bafd67325302",
        "/providers/microsoft.authorization/roleDefinitions/9980e02c-c2be-4d73-94e8-173b1dc7cf3c",
        "/providers/microsoft.authorization/roleDefinitions/acdd72a7-3385-48ef-bd42-f606fba81ae7",
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c",
        "/providers/microsoft.authorization/roleDefinitions/cd570a14-e51a-42ad-bac8-bafd67325302",
        "/providers/microsoft.authorization/roleDefinitions/f1a07417-d97a-45cb-824c-7a7467783830",
        "/providers/microsoft.authorization/roleDefinitions/fb1c8493-542b-48eb-b624-b4c8fea62acd"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "deployConfigureSuppressionRulesAzureSecurityAlertType": {
        "type": "String",
        "metadata": {
          "displayName": "Alert Type",
          "description": "Enter the alert type field of the alert you would like to suppress. Alert type could be queried via alerts api or PowerShell, learn more at https://aka.ms/asc-alertsPwoershell"
        }
      },
      "deployConfigureSuppressionRulesAzureSecuritySuppressionRuleName": {
        "type": "String",
        "metadata": {
          "displayName": "Rule name",
          "description": "Rule names must begin with a letter or a number, be between 2 and 50 characters, and contain no symbols other than dashes ( - ) or underscores ( _ )"
        }
      },
      "deployConfigureSuppressionRulesAzureSecurityReason": {
        "type": "String",
        "metadata": {
          "displayName": "Reason"
        },
        "allowedValues": [
          "The severity of the alert should be lower",
          "The alert detecting too many normal activities",
          "The alert is too noisy - hitting on the same resources too many times",
          "The resource isn't relevant for me to monitor",
          "The alert detecting normal activity on specific entity",
          "The alert isn't actionable - not clear how to investigate the threat",
          "Other"
        ]
      },
      "deployConfigureSuppressionRulesAzureSecurityExpirationDate": {
        "type": "DateTime",
        "metadata": {
          "displayName": "Expiration date"
        }
      },
      "enableSecurityCenterSAutoProvisioningLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace",
          "description": "Auto provision the Log Analytics agent on your subscriptions to monitor and collect security data using a custom workspace.",
          "strongType": "omsWorkspace"
        }
      }
    },
