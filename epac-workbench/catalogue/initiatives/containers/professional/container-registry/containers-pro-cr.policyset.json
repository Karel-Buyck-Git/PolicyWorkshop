        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Container registries to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "e9585a95-5b8c-4d03-b193-dc7eb5ac4c32",
