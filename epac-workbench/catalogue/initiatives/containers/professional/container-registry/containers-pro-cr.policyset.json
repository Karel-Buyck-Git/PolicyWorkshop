  "name": "containers-pro-cr",
  "properties": {
    "displayName": "Containers Professional — Container Registry",
    "description": "**Professional** — Active security posture for Container Registry: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Container Registry",
      "domain": "Containers",
      "tier": "Professional",
      "catalogueVersion": "2026.07.28",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c",
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureContainerRegistriesPrivateDnsZonesPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone id",
          "description": "A private DNS zone id to connect to the private endpoint. It should be linked to the private endpoint's associated VNET.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureContainerRegistriesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "a3701552-92ea-433e-9d17-33b7f1208fc9",
