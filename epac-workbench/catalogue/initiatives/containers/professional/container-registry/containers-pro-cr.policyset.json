        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Container registries with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureContainerRegistriesPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
