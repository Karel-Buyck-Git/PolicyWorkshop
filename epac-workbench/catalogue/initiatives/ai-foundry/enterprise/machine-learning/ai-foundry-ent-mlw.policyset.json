{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "ai-foundry-ent-mlw",
  "properties": {
    "displayName": "AI Foundry Enterprise — Machine Learning",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Machine Learning: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS…",
    "policyType": "Custom",
    "metadata": {
      "category": "Machine Learning",
      "domain": "AI Foundry",
      "tier": "Enterprise",
      "catalogueVersion": "2026.07.25",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/microsoft.authorization/roleDefinitions/749f88d5-cbae-40b8-bcfc-e573ddc772fa",
        "/providers/microsoft.authorization/roleDefinitions/92aaf0da-9dab-42b6-94a3-d43ce8d16293"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureDiagnosticSettingsAzureMachineLearningLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace",
          "description": "Select Log Analytics workspace from dropdown list. If this workspace is outside of the scope of the assignment you must manually grant 'Log Analytics Contributor' permissions (or similar) to the policy assignment's principal ID.",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "ba769a63-b8cc-4b2d-abf6-ac33c7204be8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ba769a63-b8cc-4b2d-abf6-ac33c7204be8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Machine Learning workspaces should be encrypted with a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7f40cee6-e933-4d0f-a782-b96615e0f4a6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7f40cee6-e933-4d0f-a782-b96615e0f4a6",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Machine Learning workspaces should be encrypted with the use of a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f59276f0-5740-4aaf-821d-45d185aa210e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f59276f0-5740-4aaf-821d-45d185aa210e",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure diagnostic settings for Azure Machine Learning Workspaces to Log Analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "profileName": {
            "value": "MachineLearningServicesDiagnosticsLogsToWorkspace"
          },
          "logAnalytics": {
            "value": "[parameters('configureDiagnosticSettingsAzureMachineLearningLogAnalytics')]"
          },
          "metricsEnabled": {
            "value": true
          },
          "logsEnabled": {
            "value": true
          }
        }
      },
      {
        "policyDefinitionReferenceId": "afe0c3be-ba3b-4544-ba52-0c99672a8ad6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/afe0c3be-ba3b-4544-ba52-0c99672a8ad6",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Resource logs in Azure Machine Learning Workspaces should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "requiredRetentionDays": {
            "value": "365"
          }
        }
      }
    ]
  }
}
