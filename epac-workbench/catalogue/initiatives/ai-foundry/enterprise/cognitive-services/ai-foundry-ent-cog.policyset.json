  "name": "ai-foundry-ent-cog",
  "properties": {
    "displayName": "AI Foundry Enterprise — Cognitive Services",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Cognitive Services: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers customer-managed keys (CMK / BYOK) for cryptographic sovereignty. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Cognitive Services",
      "domain": "AI Foundry",
      "tier": "Enterprise",
      "catalogueVersion": "2026.07.26",
      "hasRemediation": false
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {},
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "67121cc7-ff39-4ab8-b7e3-95b84dab487d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/67121cc7-ff39-4ab8-b7e3-95b84dab487d",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure AI Services resources should encrypt data at rest with a customer-managed key (CMK)"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          },
          "excludedKinds": {
            "value": [
              "CognitiveServices",
              "ContentSafety",
