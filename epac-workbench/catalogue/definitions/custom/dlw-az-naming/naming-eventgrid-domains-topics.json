{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-definition-schema.json",
  "name": "naming-eventgrid-domains-topics",
  "properties": {
    "displayName": "Require naming convention for Event Grid topic",
    "description": "Audits or denies Event Grid topic (Microsoft.EventGrid/domains/topics) that do not follow the organisation's naming convention from getResourceName.bicep. Accepted abbreviation(s): evgt. Example: 'dlw-evgt-<service>-<env>-<loc>-<instance>'. Check: name begins with the '{customerAbbreviation}-evgt-' anchor (customer + resource abbreviation). Note: Azure Policy 'like' allows a single wildcard, so only the deterministic anchor is validated, not every segment.",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
      "category": "Naming convention",
      "version": "2.0.0",
      "source": "getResourceName.bicep v1.5",
      "cafCategory": "Analytics and IoT",
      "resourceType": "Microsoft.EventGrid/domains/topics",
      "abbreviations": [
        "evgt"
      ],
      "abbreviationSource": "module (getResourceName.bicep)",
      "checkKind": "default",
      "conventionExample": "dlw-evgt-<service>-<env>-<loc>-<instance>"
    },
    "parameters": {
      "customerAbbreviation": {
        "type": "String",
        "defaultValue": "org",
        "metadata": {
          "displayName": "Customer abbreviation",
          "description": "Organization/customer abbreviation that prefixes the name (e.g. 'contoso')."
        }
      },
      "excludedNamePattern": {
        "type": "Array",
        "defaultValue": [],
        "metadata": {
          "displayName": "Excluded name patterns",
          "description": "Names matching any of these wildcard patterns are exempt. Example: 'rg-*, NetworkWatcherRG'."
        }
      },
      "effect": {
        "type": "String",
        "allowedValues": [
          "Audit",
          "Deny",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "displayName": "Effect",
          "description": "The effect of the policy (Audit, Deny or Disabled)."
        }
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.EventGrid/domains/topics"
          },
          {
            "count": {
              "value": "[parameters('excludedNamePattern')]",
              "name": "excluded",
              "where": {
                "field": "name",
                "like": "[current('excluded')]"
              }
            },
            "equals": 0
          },
          {
            "count": {
              "value": [
                "[concat(parameters('customerAbbreviation'), '-evgt-*')]"
              ],
              "name": "pattern",
              "where": {
                "field": "name",
                "like": "[current('pattern')]"
              }
            },
            "equals": 0
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
