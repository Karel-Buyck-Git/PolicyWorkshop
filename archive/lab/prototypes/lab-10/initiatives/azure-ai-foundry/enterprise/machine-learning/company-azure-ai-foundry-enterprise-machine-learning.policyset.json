{
  "name": "company-azure-ai-foundry-enterprise-machine-learning",
  "properties": {
    "displayName": "Company Azure AI Foundry Enterprise — Machine Learning",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Machine Learning: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Machine Learning",
      "domain": "Azure AI Foundry",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureMachineLearningWorkspacePrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone id",
          "description": "A private DNS zone id to connect to the private endpoint.",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureDiagnosticSettingsAzureMachineLearningLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace",
          "description": "Select Log Analytics workspace from dropdown list. If this workspace is outside of the scope of the assignment you must manually grant 'Log Analytics Contributor' permissions (or similar) to the policy assignment's principal ID.",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "ba769a63-b8cc-4b2d-abf6-ac33c7204be8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ba769a63-b8cc-4b2d-abf6-ac33c7204be8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Machine Learning workspaces should be encrypted with a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7f40cee6-e933-4d0f-a782-b96615e0f4a6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7f40cee6-e933-4d0f-a782-b96615e0f4a6",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Machine Learning workspaces should be encrypted with the use of a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "45e05259-1eb5-4f70-9574-baf73e9d219b",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/45e05259-1eb5-4f70-9574-baf73e9d219b",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Machine Learning workspaces should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "ee40564d-486e-4f68-a5ca-7a621edae0fb",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ee40564d-486e-4f68-a5ca-7a621edae0fb",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Machine Learning workspace to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureMachineLearningWorkspacePrivatePrivateDnsZoneId')]"
          },
          "secondPrivateDnsZoneId": {
            "value": ""
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f59276f0-5740-4aaf-821d-45d185aa210e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f59276f0-5740-4aaf-821d-45d185aa210e",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure diagnostic settings for Azure Machine Learning Workspaces to Log Analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "profileName": {
            "value": "MachineLearningServicesDiagnosticsLogsToWorkspace"
          },
          "logAnalytics": {
            "value": "[parameters('configureDiagnosticSettingsAzureMachineLearningLogAnalytics')]"
          },
          "metricsEnabled": {
            "value": true
          },
          "logsEnabled": {
            "value": true
          }
        }
      },
      {
        "policyDefinitionReferenceId": "afe0c3be-ba3b-4544-ba52-0c99672a8ad6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/afe0c3be-ba3b-4544-ba52-0c99672a8ad6",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Resource logs in Azure Machine Learning Workspaces should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "requiredRetentionDays": {
            "value": "365"
          }
        }
      }
    ]
  }
}
