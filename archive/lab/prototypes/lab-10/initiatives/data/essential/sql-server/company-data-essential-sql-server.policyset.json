{
  "name": "company-data-essential-sql-server",
  "properties": {
    "displayName": "Company Data Essential — SQL Server",
    "description": "**Essential** — Baseline hygiene for SQL Server: the non-negotiable controls every deployment should enforce from day one. This tier delivers TLS / HTTPS enforcement preventing in-transit interception. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "SQL Server",
      "domain": "Data",
      "tier": "Essential"
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "configureArcEnabledServersSqlServerLaWorkspaceId": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace name",
          "description": "The name of the LA workspace that needs to be linked to collect the results of the assessment.",
          "strongType": "Microsoft.OperationalInsights/workspaces"
        }
      },
      "configureArcEnabledServersSqlServerLaWorkspaceLocation": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace location",
          "description": "The location of the Log Analytics workspace. E.g eastus, westus.",
          "strongType": "location"
        }
      },
      "configureArcEnabledServersSqlServerIsEnabled": {
        "type": "Boolean",
        "metadata": {
          "displayName": "Enablement",
          "description": "Should be true to enable the assessment for the selected scope, false otherwise."
        }
      },
      "subscribeEligibleArcEnabledSqlServersEnableESU": {
        "type": "Boolean",
        "metadata": {
          "displayName": "Enable Extended Security Updates",
          "description": "Should be true to enable the ESU subscription for every SQL Server instance in the selected scope, false otherwise."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "f36de009-cacb-47b3-b936-9c4c9120d064",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f36de009-cacb-47b3-b936-9c4c9120d064",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure Arc-enabled Servers with SQL Server extension installed to enable or disable SQL best practices assessment."
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "laWorkspaceId": {
            "value": "[parameters('configureArcEnabledServersSqlServerLaWorkspaceId')]"
          },
          "laWorkspaceLocation": {
            "value": "[parameters('configureArcEnabledServersSqlServerLaWorkspaceLocation')]"
          },
          "isEnabled": {
            "value": "[parameters('configureArcEnabledServersSqlServerIsEnabled')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7148a409-0d59-4baa-925b-b3aae486a14e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7148a409-0d59-4baa-925b-b3aae486a14e",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Enable system-assigned identity to SQL VM"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f692cc79-76fb-4c61-8861-467e454ac6f8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f692cc79-76fb-4c61-8861-467e454ac6f8",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Subscribe eligible Arc-enabled SQL Servers instances to Extended Security Updates."
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "enableESU": {
            "value": "[parameters('subscribeEligibleArcEnabledSqlServersEnableESU')]"
          }
        }
      }
    ]
  }
}
