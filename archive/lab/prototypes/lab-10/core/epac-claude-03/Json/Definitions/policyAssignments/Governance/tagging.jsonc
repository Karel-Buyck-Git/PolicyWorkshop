{
    // Tagging governance initiative (includes built-in Modify, needs a managed identity).
    "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-assignment-schema.json",
    "nodeName": "/tagging/",
    "definitionEntry": {
        "policySetName": "tagging-initiative",
        "displayName": "Tagging Governance Initiative"
    },
    "assignment": {
        "name": "tagging-gov",
        "displayName": "Tagging Governance",
        "description": "Owner tag required; CostCenter inherited from RG."
    },
    "metadata": { "category": "Governance" },
    "enforcementMode": "Default",
    "managedIdentityLocations": { "*": "westeurope" },
    "parameters": { "ownerTagEffect": "Audit", "costCenterTagName": "CostCenter" },
    "scope": {
        "epac-dev": [ "/providers/Microsoft.Management/managementGroups/epac-dev-contoso" ],
        "tenant01": [ "/providers/Microsoft.Management/managementGroups/contoso" ]
    }
}
