{
  "name": "company-compute-enterprise-batch",
  "properties": {
    "displayName": "Company Compute Enterprise — Batch",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Batch: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Batch",
      "domain": "Compute",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "deployConfigurePrivateDnsZonesPrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone",
          "strongType": "Microsoft.Network/privateDnsZones",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "99e9ccd8-3db9-4592-b0d1-14b1715a4d8a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/99e9ccd8-3db9-4592-b0d1-14b1715a4d8a",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Batch account should use customer-managed keys to encrypt data"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "c520cefc-285f-40f3-86e2-2efc38ef1f64",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/c520cefc-285f-40f3-86e2-2efc38ef1f64",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Batch accounts to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "4ec38ebc-381f-45ee-81a4-acbc4be878f8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/4ec38ebc-381f-45ee-81a4-acbc4be878f8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Deploy - Configure private DNS zones for private endpoints that connect to Batch accounts"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('deployConfigurePrivateDnsZonesPrivatePrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "009a0c92-f5b4-4776-9b66-4ed2b4775563",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/009a0c92-f5b4-4776-9b66-4ed2b4775563",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Private endpoint connections on Batch accounts should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "74c5a0ae-5e48-4738-b093-65e23a060488",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/74c5a0ae-5e48-4738-b093-65e23a060488",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Public network access should be disabled for Batch accounts"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "428256e6-1fac-4f48-a757-df34c2b3336d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/428256e6-1fac-4f48-a757-df34c2b3336d",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Resource logs in Batch accounts should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "requiredRetentionDays": {
            "value": "365"
          }
        }
      }
    ]
  }
}
