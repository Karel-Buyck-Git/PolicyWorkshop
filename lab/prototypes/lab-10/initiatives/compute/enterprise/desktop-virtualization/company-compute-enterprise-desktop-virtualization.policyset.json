{
  "name": "company-compute-enterprise-desktop-virtualization",
  "properties": {
    "displayName": "Company Compute Enterprise — Desktop Virtualization",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Azure Virtual Desktop: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Desktop Virtualization",
      "domain": "Compute",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureVirtualDesktopHostpoolResourcesPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Dns Zone Id",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureAzureVirtualDesktopHostpoolResourcesPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Group Id",
          "description": "A group Id for the private endpoint"
        },
        "allowedValues": [
          "connection"
        ]
      },
      "configureAzureVirtualDesktopWorkspaceResourcesPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Dns Zone Id",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureAzureVirtualDesktopWorkspaceResourcesPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Group Id",
          "description": "A group Id for the private endpoint"
        },
        "allowedValues": [
          "feed"
        ]
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "ca950cd7-02f7-422e-8c23-91ff40f169c1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ca950cd7-02f7-422e-8c23-91ff40f169c1",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Virtual Desktop service should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "9427df23-0f42-4e1e-bf99-a6133d841c4a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/9427df23-0f42-4e1e-bf99-a6133d841c4a",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Virtual Desktop hostpool resources to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureVirtualDesktopHostpoolResourcesPrivateDnsZoneId')]"
          },
          "privateEndpointGroupId": {
            "value": "[parameters('configureAzureVirtualDesktopHostpoolResourcesPrivateEndpointGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "34804460-d88b-4922-a7ca-537165e060ed",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/34804460-d88b-4922-a7ca-537165e060ed",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Virtual Desktop workspace resources to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureVirtualDesktopWorkspaceResourcesPrivateDnsZoneId')]"
          },
          "privateEndpointGroupId": {
            "value": "[parameters('configureAzureVirtualDesktopWorkspaceResourcesPrivateEndpointGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
