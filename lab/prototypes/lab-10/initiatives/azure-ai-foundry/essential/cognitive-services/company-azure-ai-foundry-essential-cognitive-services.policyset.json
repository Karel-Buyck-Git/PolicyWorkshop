        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Cognitive Services Deployments should only use allowed prompt content filtering"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          },
          "filterName": {
            "value": "[parameters('cognitiveServicesDeploymentsAllowedPromptContentFilterName')]"
          },
          "allowedEnabledForPrompt": {
            "value": [
              "true"
            ]
          },
          "allowedBlockingForPrompt": {
            "value": [
              "true"
            ]
          }
        }
      },
      {
