{
  "name": "company-azure-ai-foundry-essential-cognitive-services",
  "properties": {
    "displayName": "Company Azure AI Foundry Essential — Cognitive Services",
    "description": "**Essential** — Baseline hygiene for Cognitive Services: the non-negotiable controls every deployment should enforce from day one. This tier delivers RBAC and managed-identity controls eliminating shared credentials and TLS / HTTPS enforcement preventing in-transit interception. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Cognitive Services",
      "domain": "Azure AI Foundry",
      "tier": "Essential"
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "cognitiveServicesDeploymentsAllowedCompletionContentFilterName": {
        "type": "string",
        "metadata": {
          "displayName": "Content Filter",
          "description": "Content filter name."
        },
        "allowedValues": [
          "Profanity",
          "Protected Material Code",
          "Protected Material Text"
        ]
      },
      "cognitiveServicesDeploymentsAllowedControlFilterName": {
        "type": "string",
        "metadata": {
          "displayName": "Content Filter",
          "description": "Multi-severity content filter name."
        },
        "allowedValues": [
          "Hate",
          "Sexual",
          "Violence",
          "Selfharm"
        ]
      },
      "cognitiveServicesDeploymentsAllowedPromptContentFilterName": {
        "type": "string",
        "metadata": {
          "displayName": "Content Filter",
          "description": "Content filter name."
        },
        "allowedValues": [
          "Profanity",
          "Jailbreak",
          "Indirect Attack",
          "Indirect Attack Spotlighting"
        ]
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "fe3fd216-4f83-4fc1-8984-2bbec80a3418",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/fe3fd216-4f83-4fc1-8984-2bbec80a3418",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Cognitive Services accounts should use a managed identity"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "af253d37-136a-42f8-a1fc-30010c083d41",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/af253d37-136a-42f8-a1fc-30010c083d41",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Cognitive Services Deployments should only use allowed completion content filtering"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          },
          "filterName": {
            "value": "[parameters('cognitiveServicesDeploymentsAllowedCompletionContentFilterName')]"
          },
          "allowedEnabledForCompletion": {
            "value": [
              "true"
            ]
          },
          "allowedBlockingForCompletion": {
            "value": [
              "true"
            ]
          }
        }
      },
      {
        "policyDefinitionReferenceId": "930f48f9-f07e-427c-9494-52603581c6a9",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/930f48f9-f07e-427c-9494-52603581c6a9",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Cognitive Services Deployments should only use allowed control"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          },
          "filterName": {
            "value": "[parameters('cognitiveServicesDeploymentsAllowedControlFilterName')]"
          },
          "allowedSeveritiesForPrompt": {
            "value": [
              "Medium",
              "High"
            ]
          },
          "allowedEnabledForPrompt": {
            "value": [
              "true"
            ]
          },
          "allowedBlockingForPrompt": {
            "value": [
              "true"
            ]
          },
          "allowedSeveritiesForCompletion": {
            "value": [
              "Medium",
              "High"
            ]
          },
          "allowedEnabledForCompletion": {
            "value": [
              "true"
            ]
          },
          "allowedBlockingForCompletion": {
            "value": [
              "true"
            ]
          }
        }
      },
      {
