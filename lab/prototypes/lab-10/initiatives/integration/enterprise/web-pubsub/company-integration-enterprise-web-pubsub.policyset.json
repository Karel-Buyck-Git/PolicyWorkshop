{
  "name": "company-integration-enterprise-web-pubsub",
  "properties": {
    "displayName": "Company Integration Enterprise — Web PubSub",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Web PubSub: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Web PubSub",
      "domain": "Integration",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureWebPubsubServicePrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone Id",
          "description": "Private DNS zone to integrate with private endpoint.",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "82909236-25f3-46a6-841c-fe1020f95ae1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/82909236-25f3-46a6-841c-fe1020f95ae1",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Web PubSub Service should use a SKU that supports private link"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "eb907f70-7514-460d-92b3-a5ae93b4f917",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/eb907f70-7514-460d-92b3-a5ae93b4f917",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Web PubSub Service should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0b026355-49cb-467b-8ac4-f777874e175a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0b026355-49cb-467b-8ac4-f777874e175a",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Web PubSub Service to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureWebPubsubServicePrivatePrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
