# Python bytecode / cache — regenerated locally, must never be committed.
__pycache__/
*.py[cod]
*.pyo

# Fetched official Azure Policy source (materialised from config/policy-source.json
# by engine/tools/fetch_policy_source.py). Reproducible on demand — never committed.
epac-workbench/.policy-source/

# EPAC deployment-plan artifacts. `Build-DeploymentPlans -OutputFolder Output`
# writes into `<package>/Output/` on any local plan run (see the generated
# .github/workflows/epac.yml). A local run must never be committed — it would
# pollute the working tree and break the contoso golden-fixture byte-diff.
**/package/Output/
