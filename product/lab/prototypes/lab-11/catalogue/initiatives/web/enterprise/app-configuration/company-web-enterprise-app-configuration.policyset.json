{
  "name": "company-web-enterprise-app-configuration",
  "properties": {
    "displayName": "Company Web Enterprise — App Configuration",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for App Configuration: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface and customer-managed keys (CMK / BYOK) for cryptographic sovereignty. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "App Configuration",
      "domain": "Web",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configurePrivateDnsZonesPrivateEndpointsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS zone",
          "description": "Specifies the private DNS zone to use to configure private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configurePrivateEndpointsAppConfigurationPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "967a4b4b-2da9-43c1-b7d0-f98d0d74d0b1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/967a4b4b-2da9-43c1-b7d0-f98d0d74d0b1",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "App Configuration should use a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "89c8a434-18f0-402c-8147-630a8dea54e0",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/89c8a434-18f0-402c-8147-630a8dea54e0",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "App Configuration should use a SKU that supports private link"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "ca610c1d-041c-4332-9d88-7ed3094967c7",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ca610c1d-041c-4332-9d88-7ed3094967c7",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "App Configuration should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7a860e27-9ca2-4fc6-822d-c2d248c300df",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7a860e27-9ca2-4fc6-822d-c2d248c300df",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure private DNS zones for private endpoints connected to App Configuration"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configurePrivateDnsZonesPrivateEndpointsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "614ffa75-862c-456e-ad8b-eaa1b0844b07",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/614ffa75-862c-456e-ad8b-eaa1b0844b07",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure private endpoints for App Configuration"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configurePrivateEndpointsAppConfigurationPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
