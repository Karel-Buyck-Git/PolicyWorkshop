        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "App Configuration should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "73290fa2-dfa7-4bbb-945d-a5e23b75df2c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/73290fa2-dfa7-4bbb-945d-a5e23b75df2c",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
