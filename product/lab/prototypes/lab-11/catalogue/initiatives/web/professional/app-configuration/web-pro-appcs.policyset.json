        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "App Configuration should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "89c8a434-18f0-402c-8147-630a8dea54e0",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/89c8a434-18f0-402c-8147-630a8dea54e0",
        "groupNames": [
          "Professional"
        ],
