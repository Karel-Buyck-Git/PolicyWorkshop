{
  "name": "company-compute-enterprise-compute",
  "properties": {
    "displayName": "Company Compute Enterprise — Compute",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Compute: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Compute",
      "domain": "Compute",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureDiskAccessResourcesPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for managed disks",
          "description": "The private DNS zone name required for managed disks to resolve a private DNS Zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureDiskAccessResourcesPrivateEndpointsLocation": {
        "type": "String",
        "metadata": {
          "displayName": "Location",
          "strongType": "location",
          "description": "All disk access resources in this region are validated and private endpoints are created in this region."
        }
      },
      "configureDiskAccessResourcesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "managedDisksSpecificSetDiskEncryptionAllowedEncryptionSets": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed disk encryption set",
          "description": "The list of allowed disk encryption sets for managed disks.",
          "strongType": "Microsoft.Compute/diskEncryptionSets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "bc05b96c-0b36-4ca9-82f0-5c53f96ce05a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/bc05b96c-0b36-4ca9-82f0-5c53f96ce05a",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure disk access resources to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureDiskAccessResourcesPrivateDnsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "582bd7a6-a5f6-4dc6-b9dc-9cb81fe0d4c5",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/582bd7a6-a5f6-4dc6-b9dc-9cb81fe0d4c5",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure disk access resources with private endpoints"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "location": {
            "value": "[parameters('configureDiskAccessResourcesPrivateEndpointsLocation')]"
          },
          "privateEndpointSubnetId": {
            "value": "[parameters('configureDiskAccessResourcesPrivateEndpointsPrivateEndpointSubnetId')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f39f5f49-4abf-44de-8c70-0756997bfb51",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f39f5f49-4abf-44de-8c70-0756997bfb51",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Disk access resources should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "ca91455f-eace-4f96-be59-e6e2c35b4816",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ca91455f-eace-4f96-be59-e6e2c35b4816",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Managed disks should be double encrypted with both platform-managed and customer-managed keys"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "d461a302-a187-421a-89ac-84acdb4edc04",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/d461a302-a187-421a-89ac-84acdb4edc04",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Managed disks should use a specific set of disk encryption sets for the customer-managed key encryption"
        },
        "parameters": {
          "allowedEncryptionSets": {
            "value": "[parameters('managedDisksSpecificSetDiskEncryptionAllowedEncryptionSets')]"
          },
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "702dd420-7fcc-42c5-afe8-4026edd20fe0",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/702dd420-7fcc-42c5-afe8-4026edd20fe0",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "OS and data disks should be encrypted with a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      }
    ]
  }
}
