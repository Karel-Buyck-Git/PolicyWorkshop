            "value": "[parameters('configureAzureVirtualDesktopWorkspaceResourcesPrivateEndpointGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "02aa841c-42e8-492f-a43d-1f2c67e58d41",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/02aa841c-42e8-492f-a43d-1f2c67e58d41",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
