{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-compute-enterprise-desktop-virtualization",
  "properties": {
    "displayName": "Company Compute Enterprise — Desktop Virtualization",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Azure Virtual Desktop: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Desktop Virtualization",
      "domain": "Compute",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureVirtualDesktopHostpoolResourcesPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Dns Zone Id",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureAzureVirtualDesktopHostpoolResourcesPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Group Id",
          "description": "A group Id for the private endpoint"
        },
        "allowedValues": [
          "connection"
        ]
      },
      "configureAzureVirtualDesktopHostpoolsPrivatePrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "privateEndpointSubnetId",
          "description": "A subnet in the location",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "configureAzureVirtualDesktopWorkspaceResourcesPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Dns Zone Id",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureAzureVirtualDesktopWorkspaceResourcesPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Group Id",
          "description": "A group Id for the private endpoint"
        },
        "allowedValues": [
          "feed"
        ]
      },
      "configureAzureVirtualDesktopWorkspacesPrivatePrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "privateEndpointSubnetId",
          "description": "A subnet in the location",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
