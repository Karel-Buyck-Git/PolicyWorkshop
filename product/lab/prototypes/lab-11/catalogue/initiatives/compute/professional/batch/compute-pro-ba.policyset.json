{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "compute-pro-ba",
  "properties": {
    "displayName": "Compute Professional — Batch",
    "description": "**Professional** — Active security posture for Batch: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Batch",
      "domain": "Compute",
      "tier": "Professional",
      "catalogueVersion": "2026.06.20",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureBatchAccountsPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "A subnet with private endpoint network policies disabled",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "deployConfigurePrivateDnsZonesPrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone",
          "strongType": "Microsoft.Network/privateDnsZones",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "c520cefc-285f-40f3-86e2-2efc38ef1f64",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/c520cefc-285f-40f3-86e2-2efc38ef1f64",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Batch accounts to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0ef5aac7-c064-427a-b87b-d47b3ddcaf73",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0ef5aac7-c064-427a-b87b-d47b3ddcaf73",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Batch accounts with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureBatchAccountsPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "4ec38ebc-381f-45ee-81a4-acbc4be878f8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/4ec38ebc-381f-45ee-81a4-acbc4be878f8",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Deploy - Configure private DNS zones for private endpoints that connect to Batch accounts"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('deployConfigurePrivateDnsZonesPrivatePrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "009a0c92-f5b4-4776-9b66-4ed2b4775563",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/009a0c92-f5b4-4776-9b66-4ed2b4775563",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Private endpoint connections on Batch accounts should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "74c5a0ae-5e48-4738-b093-65e23a060488",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/74c5a0ae-5e48-4738-b093-65e23a060488",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Public network access should be disabled for Batch accounts"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      }
    ]
  }
}
