{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "compute-pro-cmp",
  "properties": {
    "displayName": "Compute Professional — Compute",
    "description": "**Professional** — Active security posture for Compute: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Compute",
      "domain": "Compute",
      "tier": "Professional",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureDiskAccessResourcesPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for managed disks",
          "description": "The private DNS zone name required for managed disks to resolve a private DNS Zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureDiskAccessResourcesPrivateEndpointsLocation": {
        "type": "String",
        "metadata": {
          "displayName": "Location",
          "strongType": "location",
          "description": "All disk access resources in this region are validated and private endpoints are created in this region."
        }
      },
      "configureDiskAccessResourcesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "configureManagedDisksDisablePublicNetworkLocation": {
        "type": "String",
        "metadata": {
          "displayName": "Location",
          "strongType": "location",
          "description": "All disks in this region are validated and disk access resource would be associated with them."
        }
      },
      "configureManagedDisksDisablePublicNetworkDiskAccessId": {
        "type": "String",
        "metadata": {
          "displayName": "Resource Id for the DiskAccess in the given location to which the disk resource needs to be linked",
          "strongType": "Microsoft.Compute/diskAccesses",
          "description": "Disk access resources enable exporting managed disks securely via private endpoints. Learn more at: https://aka.ms/disksprivatelinksdoc"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "bc05b96c-0b36-4ca9-82f0-5c53f96ce05a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/bc05b96c-0b36-4ca9-82f0-5c53f96ce05a",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure disk access resources to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureDiskAccessResourcesPrivateDnsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "582bd7a6-a5f6-4dc6-b9dc-9cb81fe0d4c5",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/582bd7a6-a5f6-4dc6-b9dc-9cb81fe0d4c5",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure disk access resources with private endpoints"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "location": {
            "value": "[parameters('configureDiskAccessResourcesPrivateEndpointsLocation')]"
          },
          "privateEndpointSubnetId": {
            "value": "[parameters('configureDiskAccessResourcesPrivateEndpointsPrivateEndpointSubnetId')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "8426280e-b5be-43d9-979e-653d12a08638",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/8426280e-b5be-43d9-979e-653d12a08638",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure managed disks to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          },
          "location": {
            "value": "[parameters('configureManagedDisksDisablePublicNetworkLocation')]"
          },
          "diskAccessId": {
            "value": "[parameters('configureManagedDisksDisablePublicNetworkDiskAccessId')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f39f5f49-4abf-44de-8c70-0756997bfb51",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f39f5f49-4abf-44de-8c70-0756997bfb51",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Disk access resources should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "8405fdab-1faf-48aa-b702-999c9c172094",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/8405fdab-1faf-48aa-b702-999c9c172094",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Managed disks should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      }
    ]
  }
}
