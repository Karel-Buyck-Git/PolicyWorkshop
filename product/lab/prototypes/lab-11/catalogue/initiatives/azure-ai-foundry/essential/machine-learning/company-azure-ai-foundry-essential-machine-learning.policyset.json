{
  "name": "company-azure-ai-foundry-essential-machine-learning",
  "properties": {
    "displayName": "Company Azure AI Foundry Essential — Machine Learning",
    "description": "**Essential** — Baseline hygiene for Machine Learning: the non-negotiable controls every deployment should enforce from day one. This tier delivers RBAC and managed-identity controls eliminating shared credentials and TLS / HTTPS enforcement preventing in-transit interception. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Machine Learning",
      "domain": "Azure AI Foundry",
      "tier": "Essential",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "configureApprovalEndpointCalledPriorJobsApprovalEndpoint": {
        "type": "String",
        "metadata": {
          "displayName": "Approval endpoint",
          "description": "Approval endpoint that needs to be called before an Azure ML job is run. Ex. http://amlrunapproval/approve"
        }
      },
      "configureCodeSigningTrainingCodeAzureSigningKey": {
        "type": "String",
        "metadata": {
          "displayName": "PGP public key",
          "description": "Public key text in PGP public key format, with newline characters encoded as string literals \"\\r\" and \"\\n\"."
        }
      },
      "configureLogFilterExpressionsDatastoreUsedDatastore": {
        "type": "String",
        "metadata": {
          "displayName": "Datastore",
          "description": "Datastore used to store filtered logs. Ex. LogsDatastore which is configured in AML."
        }
      }
    },
