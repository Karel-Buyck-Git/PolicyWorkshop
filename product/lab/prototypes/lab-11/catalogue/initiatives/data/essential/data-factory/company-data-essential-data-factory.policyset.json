    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "85bb39b5-2f66-49f8-9306-77da3ac5130f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/85bb39b5-2f66-49f8-9306-77da3ac5130f",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Azure Data Factory integration runtime should have a limit for number of cores"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          },
          "maxCores": {
