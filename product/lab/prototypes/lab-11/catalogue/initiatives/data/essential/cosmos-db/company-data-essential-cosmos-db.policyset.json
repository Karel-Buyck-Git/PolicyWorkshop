{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-data-essential-cosmos-db",
  "properties": {
    "displayName": "Company Data Essential — Cosmos DB",
    "description": "**Essential** — Baseline hygiene for Cosmos DB: the non-negotiable controls every deployment should enforce from day one. This tier delivers RBAC and managed-identity controls eliminating shared credentials and TLS / HTTPS enforcement preventing in-transit interception. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Cosmos DB",
      "domain": "Data",
      "tier": "Essential",
      "catalogueVersion": "2026.06.12",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/5bd9cd88-fe45-4216-938b-f97437e15450"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "azureCosmosDbAllowedLocationsListOfAllowedLocations": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed locations",
          "description": "The list of locations that can be specified when deploying Azure Cosmos DB resources.",
          "strongType": "location"
        }
      },
      "azureCosmosDbThroughputLimitedThroughputMax": {
        "type": "Integer",
        "metadata": {
          "displayName": "Max RUs",
          "description": "The maximum throughput (RU/s) that can be assigned to a container via the Resource Provider during create or update."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "9d83ccb1-f313-46ce-9d39-a198bfdb51a0",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/9d83ccb1-f313-46ce-9d39-a198bfdb51a0",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Azure Cosmos DB accounts should not exceed the maximum number of days allowed since last account key regeneration."
        },
        "parameters": {
          "maxDaysSinceLastRegeneration": {
            "value": "60"
          },
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0473574d-2d43-4217-aefe-941fcdf7e684",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0473574d-2d43-4217-aefe-941fcdf7e684",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Azure Cosmos DB allowed locations"
        },
        "parameters": {
          "listOfAllowedLocations": {
            "value": "[parameters('azureCosmosDbAllowedLocationsListOfAllowedLocations')]"
          },
          "policyEffect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "4750c32b-89c0-46af-bfcb-2e4541a818d5",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/4750c32b-89c0-46af-bfcb-2e4541a818d5",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Azure Cosmos DB key based metadata write access should be disabled"
        }
      },
      {
        "policyDefinitionReferenceId": "0b7ef78e-a035-4f23-b9bd-aff122a1b1cf",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0b7ef78e-a035-4f23-b9bd-aff122a1b1cf",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Azure Cosmos DB throughput should be limited"
        },
        "parameters": {
          "throughputMax": {
            "value": "[parameters('azureCosmosDbThroughputLimitedThroughputMax')]"
          },
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "dc2d41d1-4ab1-4666-a3e1-3d51c43e0049",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/dc2d41d1-4ab1-4666-a3e1-3d51c43e0049",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure Cosmos DB database accounts to disable local authentication"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "5450f5bd-9c72-4390-a9c4-a7aba4edfdd2",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/5450f5bd-9c72-4390-a9c4-a7aba4edfdd2",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Cosmos DB database accounts should have local authentication methods disabled"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      }
    ]
  }
}
