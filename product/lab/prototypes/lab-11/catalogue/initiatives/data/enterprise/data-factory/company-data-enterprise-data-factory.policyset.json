{
  "name": "company-data-enterprise-data-factory",
  "properties": {
    "displayName": "Company Data Enterprise — Data Factory",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Data Factory: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Data Factory",
      "domain": "Data",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/673868aa-7521-48a0-acc6-0f60742d39f5"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configurePrivateDnsZonesPrivateEndpointsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone",
          "strongType": "Microsoft.Network/privateDnsZones",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint"
        }
      },
      "configurePrivateEndpointsDataFactoriesPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "4ec52d6d-beb7-40c4-9a9e-fe753254690e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/4ec52d6d-beb7-40c4-9a9e-fe753254690e",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure data factories should be encrypted with a customer-managed key"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "8b0323be-cc25-4b61-935d-002c3798c6ea",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/8b0323be-cc25-4b61-935d-002c3798c6ea",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Data Factory should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "86cd96e1-1745-420d-94d4-d3f2fe415aa4",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/86cd96e1-1745-420d-94d4-d3f2fe415aa4",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure private DNS zones for private endpoints that connect to Azure Data Factory"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configurePrivateDnsZonesPrivateEndpointsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          },
          "listOfGroupIds": {
            "value": [
              "dataFactory",
              "portal"
            ]
          }
        }
      },
      {
        "policyDefinitionReferenceId": "496ca26b-f669-4322-a1ad-06b7b5e41882",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/496ca26b-f669-4322-a1ad-06b7b5e41882",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure private endpoints for Data factories"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configurePrivateEndpointsDataFactoriesPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          },
          "groupId": {
            "value": "dataFactory"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "1cf164be-6819-4a50-b8fa-4bcaa4f98fb6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/1cf164be-6819-4a50-b8fa-4bcaa4f98fb6",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Public network access on Azure Data Factory should be disabled"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      }
    ]
  }
}
