{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "containers-ent-cis",
  "properties": {
    "displayName": "Containers Enterprise — Container Instances",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Container Instances: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers diagnostic settings streaming to Log Analytics / Event Hub / Sentinel. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Container Instances",
      "domain": "Containers",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": false
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureDiagnosticsContainerGroupLogAnalyticsWorkspaceId": {
        "type": "String",
        "metadata": {
          "displayName": "Workspace ID",
          "description": "Log Analytics workspace GUID"
        }
      },
      "configureDiagnosticsContainerGroupLogAnalyticsWorkspaceKey": {
        "type": "String",
        "metadata": {
          "displayName": "Workspace Key",
          "description": "Log Analytics workspace key"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "21c469fa-a887-4363-88a9-60bfd6911a15",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/21c469fa-a887-4363-88a9-60bfd6911a15",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure diagnostics for container group to log analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "Append"
          },
          "workspaceId": {
            "value": "[parameters('configureDiagnosticsContainerGroupLogAnalyticsWorkspaceId')]"
          },
          "workspaceKey": {
            "value": "[parameters('configureDiagnosticsContainerGroupLogAnalyticsWorkspaceKey')]"
          }
        }
      }
    ]
  }
}
