{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-integration-enterprise-service-bus",
  "properties": {
    "displayName": "Company Integration Enterprise — Service Bus",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Service Bus: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, and customer-managed keys (CMK / BYOK) for cryptographic sovereignty. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Service Bus",
      "domain": "Integration",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/090c5cfd-751d-490a-894a-3ce6f1109419",
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureServiceBusNamespacesPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID",
          "description": "Specifies the private DNS zone to use to configure private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureServiceBusNamespacesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "Specifies the subnet to use to configure private endpoint",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "1c06e275-d63d-4540-b761-71f364c2111d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/1c06e275-d63d-4540-b761-71f364c2111d",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Service Bus namespaces should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f0fcf93c-c063-4071-9668-c47474bd3564",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f0fcf93c-c063-4071-9668-c47474bd3564",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Service Bus namespaces to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureServiceBusNamespacesPrivateDnsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7d890f7f-100c-473d-baa1-2777e2266535",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7d890f7f-100c-473d-baa1-2777e2266535",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Service Bus namespaces with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureServiceBusNamespacesPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "f8d36e2f-389b-4ee4-898d-21aeb69a0f45",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f8d36e2f-389b-4ee4-898d-21aeb69a0f45",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Resource logs in Service Bus should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "requiredRetentionDays": {
            "value": "365"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "295fc8b1-dc9f-4f53-9c61-3f313ceab40a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/295fc8b1-dc9f-4f53-9c61-3f313ceab40a",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Service Bus Premium namespaces should use a customer-managed key for encryption"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      }
    ]
  }
}
