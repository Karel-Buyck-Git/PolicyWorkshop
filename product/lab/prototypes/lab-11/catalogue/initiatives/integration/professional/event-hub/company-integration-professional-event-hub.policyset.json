{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-integration-professional-event-hub",
  "properties": {
    "displayName": "Company Integration Professional — Event Hub",
    "description": "**Professional** — Active security posture for Event Hubs: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Event Hub",
      "domain": "Integration",
      "tier": "Professional",
      "catalogueVersion": "2026.06.17",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/f526a384-b230-433a-b45c-95f59c4a2dec"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureEventHubNamespacesPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID",
          "description": "Specifies the private DNS zone to use to configure private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureEventHubNamespacesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "Specifies the subnet to use to configure private endpoint",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "ed66d4f5-8220-45dc-ab4a-20d1749c74e6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ed66d4f5-8220-45dc-ab4a-20d1749c74e6",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Event Hub namespaces to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureEventHubNamespacesPrivateDnsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "91678b7c-d721-4fc5-b179-3cdf74e96b1c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/91678b7c-d721-4fc5-b179-3cdf74e96b1c",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Event Hub namespaces with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureEventHubNamespacesPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0602787f-9896-402a-a6e1-39ee63ee435e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0602787f-9896-402a-a6e1-39ee63ee435e",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Event Hub Namespaces should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "b8564268-eb4a-4337-89be-a19db070c59d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/b8564268-eb4a-4337-89be-a19db070c59d",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Event Hub namespaces should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      }
    ]
  }
}
