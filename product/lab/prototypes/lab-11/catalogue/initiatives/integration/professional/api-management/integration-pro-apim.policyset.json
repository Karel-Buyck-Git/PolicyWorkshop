  "name": "integration-pro-apim",
  "properties": {
    "displayName": "Integration Professional — API Management",
    "description": "**Professional** — Active security posture for API Management: controls that produce signals an operations team must act on. This tier delivers vulnerability assessment scanning and network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "API Management",
      "domain": "Integration",
      "tier": "Professional",
      "catalogueVersion": "2026.06.20",
      "hasRemediation": false
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {},
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "b741306c-968e-4b67-b916-5675e5c709f4",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/b741306c-968e-4b67-b916-5675e5c709f4",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "API Management direct management endpoint should not be enabled"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "73ef9241-5d81-4cd4-b483-8443d1730fe5",
