        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "API Management service should use a SKU that supports virtual networks"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          },
          "listOfAllowedSKUs": {
            "value": [
              "Developer",
              "Premium",
              "Isolated"
            ]
          }
        }
      },
      {
        "policyDefinitionReferenceId": "ef619a2c-cc4d-4d03-b2ba-8c94a834d85b",
