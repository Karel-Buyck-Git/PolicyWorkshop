{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "integration-pro-wps",
  "properties": {
    "displayName": "Integration Professional — Web PubSub",
    "description": "**Professional** — Active security posture for Web PubSub: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Web PubSub",
      "domain": "Integration",
      "tier": "Professional",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/8cf5e20a-e4b2-4e9d-b3a1-5ceb692c2761"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureAzureWebPubsubServicePrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone Id",
          "description": "Private DNS zone to integrate with private endpoint.",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureAzureWebPubsubServicePrivatePrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "bf45113f-264e-4a87-88f9-29ac8a0aca6a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/bf45113f-264e-4a87-88f9-29ac8a0aca6a",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Web PubSub Service should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "82909236-25f3-46a6-841c-fe1020f95ae1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/82909236-25f3-46a6-841c-fe1020f95ae1",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Web PubSub Service should use a SKU that supports private link"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "eb907f70-7514-460d-92b3-a5ae93b4f917",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/eb907f70-7514-460d-92b3-a5ae93b4f917",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Web PubSub Service should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "5b1213e4-06e4-4ccc-81de-4201f2f7131a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/5b1213e4-06e4-4ccc-81de-4201f2f7131a",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Web PubSub Service to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0b026355-49cb-467b-8ac4-f777874e175a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0b026355-49cb-467b-8ac4-f777874e175a",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Web PubSub Service to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureWebPubsubServicePrivatePrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "1b9c0b58-fc7b-42c8-8010-cdfa1d1b8544",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/1b9c0b58-fc7b-42c8-8010-cdfa1d1b8544",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Web PubSub Service with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureAzureWebPubsubServicePrivatePrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
