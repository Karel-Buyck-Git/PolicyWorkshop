  "name": "company-integration-essential-event-hub",
  "properties": {
    "displayName": "Company Integration Essential — Event Hub",
    "description": "**Essential** — Baseline hygiene for Event Hubs: the non-negotiable controls every deployment should enforce from day one. This tier delivers RBAC and managed-identity controls eliminating shared credentials, TLS / HTTPS enforcement preventing in-transit interception, and encryption-at-rest with service-managed keys. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Event Hub",
      "domain": "Integration",
      "tier": "Essential",
      "catalogueVersion": "2026.06.12",
      "hasRemediation": true,
