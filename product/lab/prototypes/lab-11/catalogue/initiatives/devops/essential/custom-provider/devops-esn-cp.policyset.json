{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "devops-esn-cp",
  "properties": {
    "displayName": "DevOps Essential — Custom Provider",
    "description": "**Essential** — Baseline hygiene for Custom Provider: the non-negotiable controls every deployment should enforce from day one. This tier protects against credential theft, unencrypted data exposure, and accidental data loss for Custom Provider workloads. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Custom Provider",
      "domain": "DevOps",
      "tier": "Essential",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "deployAssociationsCustomProviderTargetCustomProviderId": {
        "type": "String",
        "metadata": {
          "displayName": "Custom provider ID",
          "description": "Resource ID of the Custom provider to which resources need to be associated."
        }
      },
      "deployAssociationsCustomProviderResourceTypesToAssociate": {
        "type": "Array",
        "metadata": {
          "displayName": "Resource types to associate",
          "description": "The list of resource types to be associated to the custom provider.",
          "strongType": "resourceTypes"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "c15c281f-ea5c-44cd-90b8-fc3c14d13f0c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/c15c281f-ea5c-44cd-90b8-fc3c14d13f0c",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Deploy associations for a custom provider"
        },
        "parameters": {
          "targetCustomProviderId": {
            "value": "[parameters('deployAssociationsCustomProviderTargetCustomProviderId')]"
          },
          "resourceTypesToAssociate": {
            "value": "[parameters('deployAssociationsCustomProviderResourceTypesToAssociate')]"
          },
          "associationNamePrefix": {
            "value": "DeployedByPolicy"
          }
        }
      }
    ]
  }
}
