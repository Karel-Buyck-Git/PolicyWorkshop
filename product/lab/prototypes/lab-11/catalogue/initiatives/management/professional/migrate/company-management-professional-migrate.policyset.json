  "name": "company-management-professional-migrate",
  "properties": {
    "displayName": "Company Management Professional — Migrate",
    "description": "**Professional** — Active security posture for Migrate: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Migrate",
      "domain": "Management",
      "tier": "Professional",
      "catalogueVersion": "2026.06.12",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/microsoft.authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureAzureMigrateResourcesPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID",
          "description": "Specifies the private DNS zone to use to configure private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "7590a335-57cf-4c95-babd-ecbc8fafeb1f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7590a335-57cf-4c95-babd-ecbc8fafeb1f",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Migrate resources to use private DNS zones"
        },
