{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "management-pro-aa",
  "properties": {
    "displayName": "Management Professional — Automation",
    "description": "**Professional** — Active security posture for Automation: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Automation",
      "domain": "Management",
      "tier": "Professional",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c",
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureAzureAutomationAccountsPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS zone ID",
          "description": "Specifies the private DNS zone to use to configure private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureAzureAutomationAccountsPrivateDnsPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint group id",
          "description": "A group Id for the private endpoint"
        }
      },
      "configurePrivateEndpointConnectionsAzureAutomationPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "A subnet with private endpoint network policies disabled",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "955a914f-bf86-4f0e-acd5-e0766b0efcb6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/955a914f-bf86-4f0e-acd5-e0766b0efcb6",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Automation accounts should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "23b36a7c-9d26-4288-a8fd-c1d2fa284d8c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/23b36a7c-9d26-4288-a8fd-c1d2fa284d8c",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Automation accounts to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "6dd01e4f-1be1-4e80-9d0b-d109e04cb064",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/6dd01e4f-1be1-4e80-9d0b-d109e04cb064",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Automation accounts with private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureAutomationAccountsPrivateDnsPrivateDnsZoneId')]"
          },
          "privateEndpointGroupId": {
            "value": "[parameters('configureAzureAutomationAccountsPrivateDnsPrivateEndpointGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "c0c3130e-7dda-4187-aed0-ee4a472eaa60",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/c0c3130e-7dda-4187-aed0-ee4a472eaa60",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure private endpoint connections on Azure Automation accounts"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configurePrivateEndpointConnectionsAzureAutomationPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0c2b3618-68a8-4034-a150-ff4abc873462",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0c2b3618-68a8-4034-a150-ff4abc873462",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Private endpoint connections on Automation Accounts should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      }
    ]
  }
}
