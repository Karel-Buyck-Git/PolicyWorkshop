{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "management-pro-gen",
  "properties": {
    "displayName": "Management Professional — General",
    "description": "**Professional** — Active security posture for General: controls that produce signals an operations team must act on. This tier delivers auto-remediation deployments. Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "General",
      "domain": "Management",
      "tier": "Professional",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureSubscriptionsSetUpPreviewFeaturesFeatureName": {
        "type": "String",
        "metadata": {
          "displayName": "Feature Name",
          "description": "An example is AzureSQLDatabaseBlockGeoRedundantBackupStorage"
        }
      },
      "configureSubscriptionsSetUpPreviewFeaturesResourceProviderName": {
        "type": "String",
        "metadata": {
          "displayName": "Resource Provider Name",
          "description": "An example is Microsoft.Sql"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "e624c84f-2923-4437-9fd9-4115c6da3888",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/e624c84f-2923-4437-9fd9-4115c6da3888",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure subscriptions to set up preview features"
        },
        "parameters": {
          "featureName": {
            "value": "[parameters('configureSubscriptionsSetUpPreviewFeaturesFeatureName')]"
          },
          "resourceProviderName": {
            "value": "[parameters('configureSubscriptionsSetUpPreviewFeaturesResourceProviderName')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
