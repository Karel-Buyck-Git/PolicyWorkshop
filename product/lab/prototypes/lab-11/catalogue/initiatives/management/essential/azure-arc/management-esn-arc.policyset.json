{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "management-esn-arc",
  "properties": {
    "displayName": "Management Essential — Azure Arc",
    "description": "**Essential** — Baseline hygiene for Azure Arc: the non-negotiable controls every deployment should enforce from day one. This tier delivers TLS / HTTPS enforcement preventing in-transit interception. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Azure Arc",
      "domain": "Management",
      "tier": "Essential",
      "catalogueVersion": "2026.06.20",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/088ab73d-1256-47ae-bea9-9de8e7131f31",
        "/providers/Microsoft.Authorization/roleDefinitions/48b40c6e-82e0-4eb3-90d5-19e40f49b624"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "enableExtendedSecurityUpdatesEsusLicenseESULicenseResourceId": {
        "type": "string",
        "metadata": {
          "displayName": "Extended Security Updates (ESUs) license Resource ID.",
          "description": "Resource ID of the Extended Security Updates (ESUs) license.",
          "portalReview": "true",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "f9dfba6f-7430-4214-a666-342b3d3d0d62",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f9dfba6f-7430-4214-a666-342b3d3d0d62",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Configure Azure Arc-enabled Servers to enable automatic upgrades"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "4c660f31-eafb-408d-a2b3-6ed2260bd26c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/4c660f31-eafb-408d-a2b3-6ed2260bd26c",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Deny Extended Security Updates (ESUs) license creation or modification."
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "4864134f-d306-4ff5-94d8-ea4553b18c97",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/4864134f-d306-4ff5-94d8-ea4553b18c97",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Enable Extended Security Updates (ESUs) license to keep Windows 2012 machines protected after their support lifecycle has ended."
        },
        "parameters": {
          "ESULicenseResourceId": {
            "value": "[parameters('enableExtendedSecurityUpdatesEsusLicenseESULicenseResourceId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
