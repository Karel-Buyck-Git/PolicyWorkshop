{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "management-esn-lh",
  "properties": {
    "displayName": "Management Essential — Lighthouse",
    "description": "**Essential** — Baseline hygiene for Lighthouse: the non-negotiable controls every deployment should enforce from day one. This tier protects against credential theft, unencrypted data exposure, and accidental data loss for Lighthouse workloads. Maps to CIS Benchmarks, ISO 27001 Annex A.10 (cryptography) and A.12 (operations).",
    "policyType": "Custom",
    "metadata": {
      "category": "Lighthouse",
      "domain": "Management",
      "tier": "Essential",
      "catalogueVersion": "2026.06.19",
      "hasRemediation": false
    },
    "policyDefinitionGroups": [
      {
        "name": "Essential"
      }
    ],
    "parameters": {
      "allowManagingTenantIdsOnboardThroughListOfAllowedTenants": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed tenants",
          "description": "List of the tenants IDs that can be onboarded through Azure Lighthouse"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "7a8a51a3-ad87-4def-96f3-65a1839242b6",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7a8a51a3-ad87-4def-96f3-65a1839242b6",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Allow managing tenant ids to onboard through Azure Lighthouse"
        },
        "parameters": {
          "listOfAllowedTenants": {
            "value": "[parameters('allowManagingTenantIdsOnboardThroughListOfAllowedTenants')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "76bed37b-484f-430f-a009-fd7592dff818",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/76bed37b-484f-430f-a009-fd7592dff818",
        "groupNames": [
          "Essential"
        ],
        "metadata": {
          "policyName": "Audit delegation of scopes to a managing tenant"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      }
    ]
  }
}
