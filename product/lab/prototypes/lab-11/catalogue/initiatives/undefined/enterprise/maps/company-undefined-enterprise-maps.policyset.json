{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-undefined-enterprise-maps",
  "properties": {
    "displayName": "Company undefined Enterprise — Maps",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Maps: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Maps",
      "domain": "undefined",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configurePrivateDnsZonesPrivateEndpointsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "cb26889c-214c-4b29-811e-6f2109a1959f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/cb26889c-214c-4b29-811e-6f2109a1959f",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Maps Accounts should use private link."
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "a58f2efa-faf4-434a-8fe9-2dca18adb5f5",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/a58f2efa-faf4-434a-8fe9-2dca18adb5f5",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure private DNS zones for private endpoints that connect to Azure Maps Accounts."
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configurePrivateDnsZonesPrivateEndpointsPrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
