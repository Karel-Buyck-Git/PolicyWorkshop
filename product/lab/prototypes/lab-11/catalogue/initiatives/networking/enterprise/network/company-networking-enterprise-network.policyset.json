{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-networking-enterprise-network",
  "properties": {
    "displayName": "Company Networking Enterprise — Network",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Network: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers diagnostic settings streaming to Log Analytics / Event Hub / Sentinel and zone-redundant deployments backing the 99.99% SLA. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Network",
      "domain": "Networking",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/microsoft.authorization/roleDefinitions/749f88d5-cbae-40b8-bcfc-e573ddc772fa",
        "/providers/microsoft.authorization/roleDefinitions/92aaf0da-9dab-42b6-94a3-d43ce8d16293",
        "/providers/microsoft.authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureDiagnosticSettingsAzureNetworkSecurityLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace",
          "description": "Select the Log Analytics workspace from dropdown list",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      },
      "deployVnetFlowLogsTrafficAnalyticsResourceGroupName": {
        "type": "String",
        "metadata": {
          "displayName": "Resource Group",
          "description": "Resource group where the Storage Account and Log Analytics Workspace exists"
        }
      },
      "deployVnetFlowLogsTrafficAnalyticsUpdateFlowlog": {
        "type": "String",
        "metadata": {
          "displayName": "Update the Storage account and Log Analytics for existing vnet flowlogs",
          "description": "Set as true if the existing VNet flowlogs also need to be updated with created regional Storage account and Log Analytics workspace."
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "3e1f521a-d037-4709-bdd6-1f532f271a75",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/3e1f521a-d037-4709-bdd6-1f532f271a75",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Firewall should be deployed to span multiple Availability Zones"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "98a2e215-5382-489e-bd29-32e7190a39ba",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/98a2e215-5382-489e-bd29-32e7190a39ba",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure diagnostic settings for Azure Network Security Groups to Log Analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "diagnosticsSettingNameToUse": {
            "value": "setByPolicy"
          },
          "logAnalytics": {
            "value": "[parameters('configureDiagnosticSettingsAzureNetworkSecurityLogAnalytics')]"
          },
          "NetworkSecurityGroupEventEnabled": {
            "value": "True"
          },
          "NetworkSecurityGroupRuleCounterEnabled": {
            "value": "True"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "69f5d115-d282-4c1b-9c76-7f6640427d2e",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/69f5d115-d282-4c1b-9c76-7f6640427d2e",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Create central Log Analytics Workspace for VNet Flowlog Traffic Analytics in the specified Resource Group"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "resourceGroupName": {
            "value": "nwtarg"
          },
          "workspaceRegion": {
            "value": "eastus"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "6d7c9ba4-b4b9-4d38-9e86-f1bc6b322bde",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/6d7c9ba4-b4b9-4d38-9e86-f1bc6b322bde",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Deploy VNet Flow Logs with Traffic Analytics for VNets with regional Storage and centralized Log Analytics"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "retentionDays": {
            "value": "0"
          },
          "timeIntervalInMins": {
            "value": "60"
          },
          "workspaceRegion": {
            "value": "eastus"
          },
          "resourceGroupName": {
            "value": "[parameters('deployVnetFlowLogsTrafficAnalyticsResourceGroupName')]"
          },
          "updateFlowlog": {
            "value": "[parameters('deployVnetFlowLogsTrafficAnalyticsUpdateFlowlog')]"
          }
        }
      }
    ]
  }
}
