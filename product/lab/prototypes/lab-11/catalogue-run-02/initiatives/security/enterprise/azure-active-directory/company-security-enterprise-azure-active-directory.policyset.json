{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-security-enterprise-azure-active-directory",
  "properties": {
    "displayName": "Company Security Enterprise — Azure Active Directory",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Microsoft Entra ID (Azure AD): controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Azure Active Directory",
      "domain": "Security",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configurePrivateLinkAzureAdPrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for Private Link for Azure AD",
          "description": "The private DNS zone name required for Private Link for Azure AD to resolve a private DNS Zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configurePrivateLinkAzureAdPrivateGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint group ID",
          "description": "The group ID of the private endpoint."
        },
        "allowedValues": [
          "azureactivedirectory",
          "test"
        ]
      },
      "configurePrivateLinkAzureAdPrivatePrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "2e9411a0-0c5a-44b3-9ddb-ff10a1a2bf28",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/2e9411a0-0c5a-44b3-9ddb-ff10a1a2bf28",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Active Directory should use private link to access Azure services"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7e4301f9-5f32-4738-ad9f-7ec2d15563ad",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7e4301f9-5f32-4738-ad9f-7ec2d15563ad",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Private Link for Azure AD to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configurePrivateLinkAzureAdPrivatePrivateDnsZoneId')]"
          },
          "groupId": {
            "value": "[parameters('configurePrivateLinkAzureAdPrivateGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "b923afcf-4c3a-4ed6-8386-1ff64b68de47",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/b923afcf-4c3a-4ed6-8386-1ff64b68de47",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Private Link for Azure AD with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configurePrivateLinkAzureAdPrivatePrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      }
    ]
  }
}
