{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-container-services-enterprise-kubernetes",
  "properties": {
    "displayName": "Company Container Services Enterprise — Kubernetes",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Kubernetes: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Kubernetes",
      "domain": "Container Services",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/microsoft.authorization/roleDefinitions/749f88d5-cbae-40b8-bcfc-e573ddc772fa",
        "/providers/microsoft.authorization/roleDefinitions/92aaf0da-9dab-42b6-94a3-d43ce8d16293"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "deployConfigureDiagnosticSettingsAzureKubernetesLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace",
          "description": "Specify the Log Analytics workspace the Azure Kubernetes Service should be connected to",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "040732e8-d947-40b8-95d6-854c95024bf8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/040732e8-d947-40b8-95d6-854c95024bf8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Kubernetes Service Private Clusters should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7d7be79c-23ba-4033-84dd-45e2a5ccdd67",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7d7be79c-23ba-4033-84dd-45e2a5ccdd67",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Both operating systems and data disks in Azure Kubernetes Service clusters should be encrypted by customer-managed keys"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "6c66c325-74c8-42fd-a286-a74b0e2939d8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/6c66c325-74c8-42fd-a286-a74b0e2939d8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Deploy - Configure diagnostic settings for Azure Kubernetes Service to Log Analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "diagnosticsSettingNameToUse": {
            "value": "AzureKubernetesDiagnosticsLogsToWorkspace"
          },
          "logAnalytics": {
            "value": "[parameters('deployConfigureDiagnosticSettingsAzureKubernetesLogAnalytics')]"
          },
          "AllMetrics": {
            "value": "True"
          },
          "kube-apiserver": {
            "value": "True"
          },
          "kube-audit": {
            "value": "True"
          },
          "kube-controller-manager": {
            "value": "True"
          },
          "kube-scheduler": {
            "value": "True"
          },
          "cluster-autoscaler": {
            "value": "True"
          },
          "kube-audit-admin": {
            "value": "True"
          },
          "guard": {
            "value": "True"
          },
          "cloud-controller-manager": {
            "value": "True"
          },
          "csi-azuredisk-controller": {
            "value": "True"
          },
          "csi-azurefile-controller": {
            "value": "True"
          },
          "csi-snapshot-controller": {
            "value": "True"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "245fc9df-fa96-4414-9a0b-3738c2f7341c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/245fc9df-fa96-4414-9a0b-3738c2f7341c",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Resource logs in Azure Kubernetes Service should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "requiredRetentionDays": {
            "value": "365"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "41425d9f-d1a5-499a-9932-f8ed8453932c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/41425d9f-d1a5-499a-9932-f8ed8453932c",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Temp disks and cache for agent node pools in Azure Kubernetes Service clusters should be encrypted at host"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      }
    ]
  }
}
