{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "company-data-enterprise-cosmos-db",
  "properties": {
    "displayName": "Company Data Enterprise — Cosmos DB",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Cosmos DB: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Cosmos DB",
      "domain": "Data",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/5bd9cd88-fe45-4216-938b-f97437e15450",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureCosmosdbAccountsPrivateDnsZonesPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Dns Zone Id",
          "description": "The private DNS zone to deploy in a new private DNS zone group and link to the private endpoint",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureCosmosdbAccountsPrivateDnsZonesPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "Private Endpoint Group Id",
          "description": "A group Id for the private endpoint"
        }
      },
      "configureCosmosdbAccountsPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "privateEndpointSubnetId",
          "description": "A subnet in the location",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "configureCosmosdbAccountsPrivateEndpointsPrivateEndpointGroupId": {
        "type": "String",
        "metadata": {
          "displayName": "privateEndpointGroupId",
          "description": "A group Id for the private endpoint"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "1f905d99-2ab7-462c-a6b0-f709acca6c8f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/1f905d99-2ab7-462c-a6b0-f709acca6c8f",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Cosmos DB accounts should use customer-managed keys to encrypt data at rest"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "a63cc0bd-cda4-4178-b705-37dc439d3e0f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/a63cc0bd-cda4-4178-b705-37dc439d3e0f",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure CosmosDB accounts to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureCosmosdbAccountsPrivateDnsZonesPrivateDnsZoneId')]"
          },
          "privateEndpointGroupId": {
            "value": "[parameters('configureCosmosdbAccountsPrivateDnsZonesPrivateEndpointGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "b609e813-3156-4079-91fa-a8494c1471c4",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/b609e813-3156-4079-91fa-a8494c1471c4",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure CosmosDB accounts with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureCosmosdbAccountsPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "privateEndpointGroupId": {
            "value": "[parameters('configureCosmosdbAccountsPrivateEndpointsPrivateEndpointGroupId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "58440f8a-10c5-4151-bdce-dfbaad4a20b7",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/58440f8a-10c5-4151-bdce-dfbaad4a20b7",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "CosmosDB accounts should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      }
    ]
  }
}
