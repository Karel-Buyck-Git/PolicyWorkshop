{
  "name": "company-storage-enterprise-resilience",
  "properties": {
    "displayName": "Company Storage Enterprise — Resilience",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Resilience: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers diagnostic settings streaming to Log Analytics / Event Hub / Sentinel and zone-redundant deployments backing the 99.99% SLA. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Resilience",
      "domain": "Storage",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
