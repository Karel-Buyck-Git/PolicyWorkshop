{
  "name": "company-storage-enterprise-site-recovery",
  "properties": {
    "displayName": "Company Storage Enterprise — Site Recovery",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Site Recovery: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Site Recovery",
      "domain": "Storage",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/6670b86e-a3f7-4917-ac9b-5d6ab1be4567"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureRecoveryServicesVaultsPrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS zone Id for Azure Recovery vaults resources",
          "description": "The private DNS zone name required to resolve a private DNS Zone to recovery services vault private endpoint records.",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configurePrivateEndpointsAzureRecoveryServicesPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "A subnet with private endpoint network policies disabled",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "942bd215-1a66-44be-af65-6a1c0318dbe2",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/942bd215-1a66-44be-af65-6a1c0318dbe2",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Recovery Services vaults to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureRecoveryServicesVaultsPrivatePrivateDnsZoneId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "e95a8a5c-0987-421f-84ab-df4d88ebf7d1",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/e95a8a5c-0987-421f-84ab-df4d88ebf7d1",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure private endpoints on Azure Recovery Services vaults"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configurePrivateEndpointsAzureRecoveryServicesPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "11e3da8c-1d68-4392-badd-0ff3c43ab5b0",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/11e3da8c-1d68-4392-badd-0ff3c43ab5b0",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Recovery Services vaults should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      }
    ]
  }
}
