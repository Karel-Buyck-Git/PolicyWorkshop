{
  "name": "company-data-enterprise-azure-databricks",
  "properties": {
    "displayName": "Company Data Enterprise — Azure Databricks",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Azure Databricks: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, and customer-managed keys (CMK / BYOK) for cryptographic sovereignty. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Azure Databricks",
      "domain": "Data",
      "tier": "Enterprise",
      "catalogueVersion": "2026.06.11",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
        "/providers/Microsoft.Authorization/roleDefinitions/b24988ac-6180-42a0-ab88-20f7382dd24c",
        "/providers/microsoft.authorization/roleDefinitions/749f88d5-cbae-40b8-bcfc-e573ddc772fa",
        "/providers/microsoft.authorization/roleDefinitions/92aaf0da-9dab-42b6-94a3-d43ce8d16293"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureDatabricksWorkspacePrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for workspaces",
          "description": "The private DNS zone name required for workspaces to resolve a private DNS Zone.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureAzureDatabricksWorkspacesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "Specifies the subnet to use to configure private endpoint",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "configureDiagnosticSettingsAzureDatabricksWorkspacesLogAnalytics": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics workspace",
          "description": "Select Log Analytics workspace from dropdown list. If this workspace is outside of the scope of the assignment you must manually grant 'Log Analytics Contributor' permissions (or similar) to the policy assignment's principal ID.",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "2cc2c3b5-c2f8-45aa-a9e6-f90d85ae8352",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/2cc2c3b5-c2f8-45aa-a9e6-f90d85ae8352",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Databricks workspaces should be Premium SKU that supports features like private link, customer-managed key for encryption"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "258823f2-4595-4b52-b333-cc96192710d8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/258823f2-4595-4b52-b333-cc96192710d8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Databricks Workspaces should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "0eddd7f3-3d9b-4927-a07a-806e8ac9486c",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/0eddd7f3-3d9b-4927-a07a-806e8ac9486c",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Databricks workspace to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureDatabricksWorkspacePrivateDnsPrivateDnsZoneId')]"
          },
          "groupId": {
            "value": "databricks_ui_api"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "09210db3-d32c-4b2b-b4e1-f72ae920eb11",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/09210db3-d32c-4b2b-b4e1-f72ae920eb11",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Databricks Workspaces with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureAzureDatabricksWorkspacesPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "23057b42-ca8d-4aa0-a3dc-96a98b5b5a3d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/23057b42-ca8d-4aa0-a3dc-96a98b5b5a3d",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure diagnostic settings for Azure Databricks Workspaces to Log Analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "profileName": {
            "value": "AzureDatabricksServicesDiagnosticsLogsToWorkspace"
          },
          "logAnalytics": {
            "value": "[parameters('configureDiagnosticSettingsAzureDatabricksWorkspacesLogAnalytics')]"
          },
          "logsEnabled": {
            "value": true
          }
        }
      },
      {
        "policyDefinitionReferenceId": "138ff14d-b687-4faa-a81c-898c91a87fa2",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/138ff14d-b687-4faa-a81c-898c91a87fa2",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Resource logs in Azure Databricks Workspaces should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "requiredRetentionDays": {
            "value": "365"
          }
        }
      }
    ]
  }
}
