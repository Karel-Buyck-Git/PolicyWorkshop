  "properties": {
    "displayName": "Compute Essential — Compute",
    "description": "**Essential** — Baseline hygiene for Compute: the non-negotiable controls every deployment should enforce from day one. This tier delivers RBAC and managed-identity controls eliminating shared credentials, TLS / HTTPS enforcement preventing in-transit interception, encryption-at-rest with service-managed keys, and tagging, SKU, and naming controls for cost and ownership accountability. Together these policies protect against credential theft, unencrypted data exposure, and accidental data loss. Maps to CIS…",
    "policyType": "Custom",
    "metadata": {
      "category": "Compute",
      "domain": "Compute",
      "tier": "Essential",
      "catalogueVersion": "2026.06.21",
