        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for privatelink.guestconfiguration.azure.com",
          "description": "The private DNS zone ID used to resolve a private DNS Zone to the Guest Configuration service.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureAzureArcPrivateLinkScopesPrivateDnsZoneIDForHybridResourceProvider": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone ID for privatelink.his.arc.azure.com",
          "description": "The private DNS zone ID used to resolve a private DNS Zone to the Azure Arc metadata and identity service.",
          "strongType": "Microsoft.Network/privateDnsZones",
          "assignPermissions": true
        }
      },
      "configureAzureArcPrivateLinkScopesPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet ID",
          "description": "A subnet with private endpoint network policies disabled.",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      },
      "configureAzureArcEnabledKubernetesClustersPrivateLinkScopeId": {
        "type": "String",
        "metadata": {
          "displayName": "Azure Arc Private Link Scope ID",
          "description": "The Azure Arc Private Link Scope to associate with the Azure Arc-enabled kubernetes cluster.",
          "strongType": "Microsoft.HybridCompute/privateLinkScopes"
        }
      },
      "configureAzureArcEnabledServersAzurePrivateLinkScopeId": {
        "type": "String",
        "metadata": {
          "displayName": "Azure Arc Private Link Scope ID",
          "description": "The Azure Arc Private Link Scope to associate with the Azure Arc-enabled server.",
          "strongType": "Microsoft.HybridCompute/privateLinkScopes"
        }
      }
    },
