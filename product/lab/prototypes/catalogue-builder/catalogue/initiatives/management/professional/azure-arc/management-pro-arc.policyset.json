        "/providers/microsoft.authorization/roleDefinitions/34e09817-6cbe-4d01-b1a2-e0eac5743d41",
        "/providers/microsoft.authorization/roleDefinitions/cd570a14-e51a-42ad-bac8-bafd67325302"
      ]
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
