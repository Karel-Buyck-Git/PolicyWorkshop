{
  "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-set-definition-schema.json",
  "name": "management-pro-arc",
  "properties": {
    "displayName": "Management Professional — Azure Arc",
    "description": "**Professional** — Active security posture for Azure Arc: controls that produce signals an operations team must act on. This tier delivers network hardening (public access disabled, VNet integration, firewall rules). Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Azure Arc",
      "domain": "Management",
      "tier": "Professional",
      "catalogueVersion": "2026.06.21",
      "hasRemediation": true,
      "roleDefinitionIds": [
        "/providers/Microsoft.Authorization/roleDefinitions/34e09817-6cbe-4d01-b1a2-e0eac5743d41",
        "/providers/Microsoft.Authorization/roleDefinitions/4d97b98b-1d4f-4787-a291-c67834d212e7",
