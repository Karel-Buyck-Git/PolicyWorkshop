        }
      },
      {
        "policyDefinitionReferenceId": "e8185402-357b-4768-8058-f620bc0ae6b5",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/e8185402-357b-4768-8058-f620bc0ae6b5",
        "groupNames": [
