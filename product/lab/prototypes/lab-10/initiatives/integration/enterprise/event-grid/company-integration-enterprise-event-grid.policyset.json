{
  "name": "company-integration-enterprise-event-grid",
  "properties": {
    "displayName": "Company Integration Enterprise — Event Grid",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Event Grid: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Event Grid",
      "domain": "Integration",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
