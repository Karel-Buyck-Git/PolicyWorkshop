{
  "name": "company-data-professional-synapse",
  "properties": {
    "displayName": "Company Data Professional — Synapse",
    "description": "**Professional** — Active security posture for Synapse: controls that produce signals an operations team must act on. This tier delivers vulnerability assessment scanning, network hardening (public access disabled, VNet integration, firewall rules), audit-log and monitoring controls that produce signals for ops teams, and auto-remediation deployments. Together these policies protect against unauthorized network exposure, exploitable vulnerabilities, and undetected privilege misuse. Maps to NIS2 Article 21 (detection & response), ISO 27001 A.12.4 (logging) and A.13 (network security).",
    "policyType": "Custom",
    "metadata": {
      "category": "Synapse",
      "domain": "Data",
      "tier": "Professional"
    },
    "policyDefinitionGroups": [
      {
        "name": "Professional"
      }
    ],
    "parameters": {
      "configureAzureSynapseWorkspacesPrivateEndpointsPrivateEndpointSubnetId": {
        "type": "String",
        "metadata": {
          "displayName": "Private endpoint subnet id",
          "description": "A subnet with private endpoint network policies disabled",
          "strongType": "Microsoft.Network/virtualNetworks/subnets"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "e04e5000-cd89-451d-bb21-a14d24ff9c73",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/e04e5000-cd89-451d-bb21-a14d24ff9c73",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Auditing on Synapse workspace should be enabled"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          },
          "setting": {
            "value": "enabled"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "38d8df46-cf4e-4073-8e03-48c24b29de0d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/38d8df46-cf4e-4073-8e03-48c24b29de0d",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Azure Synapse workspaces should disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "5c8cad01-ef30-4891-b230-652dadb4876a",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/5c8cad01-ef30-4891-b230-652dadb4876a",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Synapse workspaces to disable public network access"
        },
        "parameters": {
          "effect": {
            "value": "Modify"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "3b3b0c27-08d2-4b32-879d-19930bee3266",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/3b3b0c27-08d2-4b32-879d-19930bee3266",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Configure Azure Synapse workspaces with private endpoints"
        },
        "parameters": {
          "privateEndpointSubnetId": {
            "value": "[parameters('configureAzureSynapseWorkspacesPrivateEndpointsPrivateEndpointSubnetId')]"
          },
          "effect": {
