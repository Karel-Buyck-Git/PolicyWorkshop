          }
        }
      },
      {
        "policyDefinitionReferenceId": "2d9dbfa3-927b-4cf0-9d0f-08747f971650",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/2d9dbfa3-927b-4cf0-9d0f-08747f971650",
        "groupNames": [
          "Professional"
        ],
        "metadata": {
          "policyName": "Managed workspace virtual network on Azure Synapse workspaces should be enabled"
