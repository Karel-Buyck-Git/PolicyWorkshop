{
  "name": "company-data-enterprise-synapse",
  "properties": {
    "displayName": "Company Data Enterprise — Synapse",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Synapse: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, diagnostic settings streaming to Log Analytics / Event Hub / Sentinel, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Synapse",
      "domain": "Data",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureSynapseWorkspacesPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone id",
          "description": "A private DNS zone Id",
          "strongType": "Microsoft.Network/privateDnsZones"
        }
      },
      "configureSynapseWorkspacesAuditingEnabledStorageAccountsResourceGroup": {
        "type": "string",
        "metadata": {
          "displayName": "Resource group name for storage accounts",
          "description": "Auditing writes database events to an audit log in your Azure Storage account (a storage account will be created in each region where a Synapse workspace is created that will be shared by all Synapse workspaces in that region). Important - for proper operation of Auditing do not delete or rename the resource group or the storage accounts.",
          "strongType": "existingResourceGroups",
          "assignPermissions": true
        }
      },
      "configureSynapseWorkspacesAuditingEnabledLogLogAnalyticsWorkspaceId": {
        "type": "String",
        "metadata": {
          "displayName": "Log Analytics Workspace ID",
          "description": "Auditing will write database events to this Log Analytics Workspace. This should be in the following format '/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/{resourcegroup}/providers/Microsoft.OperationalInsights/workspaces/{logAnalyticsWorkspaceName}'",
          "strongType": "omsWorkspace",
          "assignPermissions": true
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "f7d52b2d-e161-4dfa-a82b-55e564167385",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/f7d52b2d-e161-4dfa-a82b-55e564167385",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Synapse workspaces should use customer-managed keys to encrypt data at rest"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "72d11df1-dd8a-41f7-8925-b05b960ebafc",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/72d11df1-dd8a-41f7-8925-b05b960ebafc",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Synapse workspaces should use private link"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "1e5ed725-f16c-478b-bd4b-7bfa2f7940b9",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/1e5ed725-f16c-478b-bd4b-7bfa2f7940b9",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Synapse workspaces to use private DNS zones"
        },
        "parameters": {
          "privateDnsZoneId": {
            "value": "[parameters('configureAzureSynapseWorkspacesPrivateDnsPrivateDnsZoneId')]"
          },
          "targetSubResource": {
            "value": "Dev"
          },
          "effect": {
            "value": "DeployIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "ac7891a4-ac7a-4ba0-9ae9-c923e5a225ee",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/ac7891a4-ac7a-4ba0-9ae9-c923e5a225ee",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Synapse workspaces to have auditing enabled"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "retentionDays": {
            "value": 180
          },
          "storageAccountsResourceGroup": {
            "value": "[parameters('configureSynapseWorkspacesAuditingEnabledStorageAccountsResourceGroup')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "32ba8d30-07c0-4136-ab18-9a11bf4a67b7",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/32ba8d30-07c0-4136-ab18-9a11bf4a67b7",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Synapse workspaces to have auditing enabled to Log Analytics workspace"
        },
        "parameters": {
          "effect": {
            "value": "DeployIfNotExists"
          },
          "logAnalyticsWorkspaceId": {
            "value": "[parameters('configureSynapseWorkspacesAuditingEnabledLogLogAnalyticsWorkspaceId')]"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "56fd377d-098c-4f02-8406-81eb055902b8",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/56fd377d-098c-4f02-8406-81eb055902b8",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "IP firewall rules on Azure Synapse workspaces should be removed"
        },
        "parameters": {
          "effect": {
            "value": "Audit"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "2b18f286-371e-4b80-9887-04759970c0d3",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/2b18f286-371e-4b80-9887-04759970c0d3",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Synapse workspace auditing settings should have action groups configured to capture critical activities"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "529ea018-6afc-4ed4-95bd-7c9ee47b00bc",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/529ea018-6afc-4ed4-95bd-7c9ee47b00bc",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Synapse workspaces with SQL auditing to storage account destination should be configured with 90 days retention or higher"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      }
    ]
  }
}
