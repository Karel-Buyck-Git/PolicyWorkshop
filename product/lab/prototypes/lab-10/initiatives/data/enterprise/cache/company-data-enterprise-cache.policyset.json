{
  "name": "company-data-enterprise-cache",
  "properties": {
    "displayName": "Company Data Enterprise — Cache",
    "description": "**Enterprise** — Zero-trust and regulatory alignment for Cache: controls that require infrastructure investment or map directly to compliance frameworks. This tier delivers private endpoints and private link removing the public attack surface, customer-managed keys (CMK / BYOK) for cryptographic sovereignty, and direct mapping to regulatory framework controls. Together these policies protect against lateral movement, sovereign-data exfiltration, and audit gaps in regulated workloads. Maps to NIS2 Articles 21–23, ISO 27001 A.13.1.3 (network segregation) and A.18 (compliance), NIST SP 800-207 (Zero Trust).",
    "policyType": "Custom",
    "metadata": {
      "category": "Cache",
      "domain": "Data",
      "tier": "Enterprise"
    },
    "policyDefinitionGroups": [
      {
        "name": "Enterprise"
      }
    ],
    "parameters": {
      "configureAzureCacheRedisEnterprisePrivatePrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone Id",
          "strongType": "Microsoft.Network/privateDnsZones",
          "description": "The resource id of the private DNS zone"
        }
      },
      "configureAzureCacheRedisPrivateDnsPrivateDnsZoneId": {
        "type": "String",
        "metadata": {
          "displayName": "Private DNS Zone Id",
          "strongType": "Microsoft.Network/privateDnsZones",
          "description": "The resource id of the private DNS zone"
        }
      }
    },
    "policyDefinitions": [
      {
        "policyDefinitionReferenceId": "09aa11bb-87ec-409f-bf0b-49b7c1561a87",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/09aa11bb-87ec-409f-bf0b-49b7c1561a87",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Cache for Redis Enterprise should use customer-managed keys for encrypting disk data"
        },
        "parameters": {
          "effect": {
            "value": "Deny"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "960e650e-9ce3-4316-9590-8ee2c016ca2f",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/960e650e-9ce3-4316-9590-8ee2c016ca2f",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Cache for Redis Enterprise should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7803067c-7d34-46e3-8c79-0ca68fc4036d",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7803067c-7d34-46e3-8c79-0ca68fc4036d",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Azure Cache for Redis should use private link"
        },
        "parameters": {
          "effect": {
            "value": "AuditIfNotExists"
          }
        }
      },
      {
        "policyDefinitionReferenceId": "7473e756-98d9-4d10-9a22-8101ef32cd74",
        "policyDefinitionId": "/providers/Microsoft.Authorization/policyDefinitions/7473e756-98d9-4d10-9a22-8101ef32cd74",
        "groupNames": [
          "Enterprise"
        ],
        "metadata": {
          "policyName": "Configure Azure Cache for Redis Enterprise to use private DNS zones"
        },
        "parameters": {
