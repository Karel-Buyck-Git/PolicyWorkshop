{
    // Minimal single-policy assignment example (built-in "Allowed locations").
    // Shows the simplest possible assignment file.
    "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-assignment-schema.json",
    "nodeName": "/allowed-locations",
    "definitionEntry": {
        "policyId": "/providers/Microsoft.Authorization/policyDefinitions/e56962a6-4747-49cd-b67b-bf8b01975c4c",
        "displayName": "Allowed locations (built-in)"
    },
    "assignment": {
        "name": "allowed-locations",
        "displayName": "Allowed Locations",
        "description": "Restricts the regions resources can be deployed to."
    },
    "enforcementMode": "Default",
    "parameters": {
        "listOfAllowedLocations": [ "westeurope", "northeurope" ]
    },
    "scope": {
        "epac-dev": [
            "/providers/Microsoft.Management/managementGroups/epac-contoso"
        ],
        "tenant": [
            "/providers/Microsoft.Management/managementGroups/contoso"
        ]
    }
}
